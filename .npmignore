# The npm package ships only the deploy set via package.json "files".
# This is a defensive exclusion so machine-specific, generated, or reference
# content can never leak into a publish even if a "files" entry widens.
claude/settings.json
codex/config.toml
**/__pycache__/
*.pyc
.DS_Store
ko/
benchmarks/
IMPLEMENTATION_MAP.html
.onto/
