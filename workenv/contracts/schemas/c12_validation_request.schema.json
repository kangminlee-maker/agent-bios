{
  "title": "C12 validation request",
  "description": "Validate exact targets with exact lenses. Every target is a pinned revision or event by digest, every lens is pinned by name, version and digest, and the domain package the questions belong to is named by the `source_manifest` of the package source's revision; a validator that is not one of these lenses has nothing to run. Expected evidence and counterexamples are named so a run that ignores them can be seen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema",
    "targets",
    "package_digest",
    "lenses"
  ],
  "x-unique-by": {
    "key": "name",
    "across": [
      "lenses"
    ]
  },
  "properties": {
    "kind": {
      "const": "validation_request"
    },
    "schema": {
      "const": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "package_digest": {
      "$ref": "#/$defs/digest"
    },
    "questions": {
      "$ref": "#/$defs/digests"
    },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pinned_lens"
      }
    },
    "expected": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/expected_evidence"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "pinned_lens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "expected_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expects",
        "digest"
      ],
      "properties": {
        "expects": {
          "enum": [
            "evidence",
            "counterexample"
          ]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
