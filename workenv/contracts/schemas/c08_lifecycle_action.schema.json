{
  "type": "object",
  "additionalProperties": false,
  "title": "C08 lifecycle action",
  "description": "Archive, continue, restore, leave, forget here, close, purge, cancelling an unused founding and recovering a closed Team's evidence are nine different effects, and each carries what its own effect requires. Each travels in the operation whose authority it needs: archive, restore, close and cancelling a founding are the Team's governance (`team.lifecycle.apply`); purge and evidence recovery are retention (`team.retention.apply`); continuing archived work is contribution (`team.continuation.record`); leaving is the member's own (`team.membership.leave`); and forgetting is this device's (`team.device.forget`). Leaving, forgetting and cancelling say what becomes of the unique work they would strand; closure carries its whole plan and names the surviving stewardship rather than an intended successor, because naming one is what the design says is insufficient. Forgetting a Team on this device is not closure, closure is not physical deletion, and recovering a closed Team's evidence does not reopen it.",
  "required": [
    "kind",
    "schema",
    "team_id",
    "action"
  ],
  "properties": {
    "kind": {
      "const": "lifecycle_action"
    },
    "schema": {
      "const": 1
    },
    "team_id": {
      "$ref": "#/$defs/team_id"
    },
    "action": {
      "$ref": "#/$defs/team_action"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "duty"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        },
        "duty": {
          "enum": [
            "owner",
            "reviewer",
            "recovery",
            "finalizer"
          ]
        }
      }
    },
    "principal_id": {
      "type": "string",
      "pattern": "^prn_[0-9a-f]{32}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^dev_[0-9a-f]{32}$"
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/repository_scope"
        },
        {
          "$ref": "#/$defs/personal_scope"
        },
        {
          "$ref": "#/$defs/team_scope"
        }
      ]
    },
    "team_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "team_id"
      ],
      "properties": {
        "layer": {
          "const": "team"
        },
        "team_id": {
          "$ref": "#/$defs/team_id"
        }
      }
    },
    "team_id": {
      "type": "string",
      "pattern": "^tem_[0-9a-f]{32}$"
    },
    "personal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "principal_id"
      ],
      "properties": {
        "layer": {
          "const": "personal"
        },
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        }
      }
    },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "repository_id"
      ],
      "properties": {
        "layer": {
          "const": "repository"
        },
        "repository_id": {
          "$ref": "#/$defs/repository_id"
        }
      }
    },
    "repository_id": {
      "type": "string",
      "pattern": "^rep_[0-9a-f]{32}$"
    },
    "archive_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "does"
      ],
      "properties": {
        "does": {
          "const": "archive"
        }
      }
    },
    "continue_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "does",
        "work_scope",
        "continues"
      ],
      "properties": {
        "does": {
          "const": "continue_archived"
        },
        "work_scope": {
          "$ref": "#/$defs/scope"
        },
        "continues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          },
          "description": "Evidence of the existing logical work this continues — its workstream or operation records. A continuation label alone names nothing."
        }
      }
    },
    "restore_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "does"
      ],
      "properties": {
        "does": {
          "const": "restore"
        }
      }
    },
    "leave_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "does",
        "principal_id",
        "continuity"
      ],
      "properties": {
        "does": {
          "const": "leave"
        },
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        },
        "continuity": {
          "$ref": "#/$defs/work_disposition"
        }
      }
    },
    "forget_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "does",
        "device_id",
        "drafts"
      ],
      "properties": {
        "does": {
          "const": "forget_here"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "drafts": {
          "$ref": "#/$defs/work_disposition"
        }
      }
    },
    "close_action": {
      "type": "object",
      "additionalProperties": false,
      "description": "Permanent closure carries the exact plan it commits, so what was reviewed is what closes.",
      "required": [
        "does",
        "plan"
      ],
      "properties": {
        "does": {
          "const": "close"
        },
        "plan": {
          "$ref": "#/$defs/closure_plan"
        }
      }
    },
    "purge_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "does",
        "object_digests",
        "per_owner_outcomes"
      ],
      "properties": {
        "does": {
          "const": "purge"
        },
        "object_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "per_owner_outcomes": {
          "const": true
        }
      }
    },
    "team_action": {
      "oneOf": [
        {
          "$ref": "#/$defs/archive_action"
        },
        {
          "$ref": "#/$defs/continue_action"
        },
        {
          "$ref": "#/$defs/restore_action"
        },
        {
          "$ref": "#/$defs/leave_action"
        },
        {
          "$ref": "#/$defs/forget_action"
        },
        {
          "$ref": "#/$defs/close_action"
        },
        {
          "$ref": "#/$defs/purge_action"
        },
        {
          "$ref": "#/$defs/cancel_founding_action"
        },
        {
          "$ref": "#/$defs/recover_evidence_action"
        }
      ]
    },
    "cancel_founding_action": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cancel an unused, incomplete founding: its exact pending proposal and invitations stop, the Team id becomes terminal so a late acceptance cannot revive it, and drafts and uncertain external effects keep an explicit disposition.",
      "required": [
        "does",
        "proposal_digest",
        "drafts"
      ],
      "properties": {
        "does": {
          "const": "cancel_founding"
        },
        "proposal_digest": {
          "$ref": "#/$defs/digest"
        },
        "drafts": {
          "$ref": "#/$defs/work_disposition"
        }
      }
    },
    "recover_evidence_action": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read, preserve or clean up retained evidence of a closed Team under its own authorization. It never reopens the Team or resumes its work.",
      "required": [
        "does",
        "evidence_digests",
        "purpose"
      ],
      "properties": {
        "does": {
          "const": "recover_evidence"
        },
        "evidence_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "purpose": {
          "enum": [
            "read",
            "preserve",
            "clean_up"
          ]
        }
      }
    },
    "work_disposition": {
      "type": "object",
      "additionalProperties": false,
      "description": "What becomes of each piece of unique work the effect would otherwise strand: drafts, outbox entries, operations whose outcome is unknown, delegations and external effects. Each item is settled one named way; an empty list states that nothing unique is held, rather than leaving it unsaid.",
      "required": [
        "items"
      ],
      "x-unique-by": {
        "key": "subject_digest",
        "across": [
          "items"
        ]
      },
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/disposition_item"
          }
        }
      }
    },
    "disposition_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_digest",
        "holds",
        "settled"
      ],
      "properties": {
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "holds": {
          "enum": [
            "draft",
            "outbox_entry",
            "unknown_operation",
            "delegation",
            "external_effect"
          ]
        },
        "settled": {
          "$ref": "#/$defs/settlement"
        }
      }
    },
    "settlement": {
      "oneOf": [
        {
          "$ref": "#/$defs/transferred_work"
        },
        {
          "$ref": "#/$defs/exported_work"
        },
        {
          "$ref": "#/$defs/kept_work"
        },
        {
          "$ref": "#/$defs/reconciled_work"
        },
        {
          "$ref": "#/$defs/discarded_work"
        }
      ]
    },
    "transferred_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "to_principal_id"
      ],
      "properties": {
        "by": {
          "const": "transfer"
        },
        "to_principal_id": {
          "$ref": "#/$defs/principal_id"
        }
      }
    },
    "exported_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "package_digest"
      ],
      "properties": {
        "by": {
          "const": "export"
        },
        "package_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "kept_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "holder_device_id"
      ],
      "properties": {
        "by": {
          "const": "keeping"
        },
        "holder_device_id": {
          "$ref": "#/$defs/device_id"
        }
      }
    },
    "reconciled_work": {
      "type": "object",
      "additionalProperties": false,
      "description": "Asked again by the same request until its actual result was known; the result is named.",
      "required": [
        "by",
        "result_digest"
      ],
      "properties": {
        "by": {
          "const": "reconciliation"
        },
        "result_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "discarded_work": {
      "type": "object",
      "additionalProperties": false,
      "description": "Given up only on the named consent of the person whose work it is.",
      "required": [
        "by",
        "consent_digest"
      ],
      "properties": {
        "by": {
          "const": "consented_discard"
        },
        "consent_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "closure_plan": {
      "type": "object",
      "additionalProperties": false,
      "description": "What permanent closure settles before it commits: who stewards what survives, every outbox entry and unknown operation, which holders were reached, the custody that must outlive the Team, the repository and any purge. A holder not reached is listed as such, because an unreachable peer is not evidence that it holds no unique work.",
      "required": [
        "surviving_stewardship",
        "outbox",
        "holders",
        "custody_commitment_digests",
        "repository",
        "purge"
      ],
      "x-unique-by": {
        "key": "device_id",
        "across": [
          "holders"
        ]
      },
      "properties": {
        "surviving_stewardship": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/responsibility"
          }
        },
        "outbox": {
          "$ref": "#/$defs/work_disposition"
        },
        "holders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/holder_reach"
          }
        },
        "custody_commitment_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "repository": {
          "enum": [
            "none",
            "kept_independent",
            "separately_scoped"
          ]
        },
        "purge": {
          "enum": [
            "not_requested",
            "separately_governed"
          ]
        }
      }
    },
    "holder_reach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "reached"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "reached": {
          "type": "boolean"
        }
      }
    }
  }
}
