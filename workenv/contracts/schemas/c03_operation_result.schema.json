          "pattern": "^(?:/[^/]*)*$"
        }
      }
    },
    "committed_outcome": {
      "type": "object",
      "additionalProperties": false,
      "description": "A commit names the receipt that makes it accepted and states only gaps that qualify a commit — never one that would have prevented it.",
      "required": [
        "stage",
        "receipt_digest",
        "material_gaps"
      ],
      "properties": {
        "stage": {
          "const": "committed"
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "material_gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/disclosed_gap"
          }
        }
      }
    },
    "uncommitted_outcome": {
