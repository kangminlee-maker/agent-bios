{
  "type": "object",
  "additionalProperties": false,
  "title": "C03 operation result",
  "description": "What one request actually did, written whole by the runtime. It always names the digest of the request it answers; a query for an id the owner never received is answered by `request_not_held`, so nothing a result says can sit beside a request nobody holds. A stored result cannot show that a model read, kept or obeyed a returned body. A committed outcome names its receipt and states only disclosures; a gap that prevents a commit, such as a stale base, belongs to an outcome that did not commit.",
  "required": [
    "kind",
    "schema",
    "request_id",
    "request_digest",
    "local_effect",
    "provider_effect",
    "outcome",
    "outputs",
    "supported_recovery"
  ],
  "properties": {
    "kind": {
      "const": "operation_result"
    },
    "schema": {
      "const": 1
    },
    "request_id": {
      "$ref": "#/$defs/request_id"
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "local_effect": {
      "description": "What the request wrote on this side: `committed` when an owner commit landed (a committed outcome, or a partial one whose committed items name receipts), `private_state_written` when it wrote private state without a commit (a previewed composition, a blocked use sealing its question, an attempt the owner records), `candidate_stored` or `objects_staged` for a stored candidate or staged objects, and `none` when it wrote nothing.",
      "enum": [
        "none",
        "private_state_written",
        "candidate_stored",
        "objects_staged",
        "committed"
      ]
    },
    "provider_effect": {
      "enum": [
        "not_applicable",
        "none",
        "queued",
        "dispatched",
        "committed",
        "unknown"
      ]
    },
    "outcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/committed_outcome"
        },
        {
          "$ref": "#/$defs/uncommitted_outcome"
        }
      ]
    },
    "outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "supported_recovery": {
      "$ref": "#/$defs/recovery"
    }
  },
  "x-runtime-owned": true,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gap": {
