{
  "type": "object",
  "additionalProperties": false,
  "title": "C03 operation result",
  "description": "What one request actually did, written whole by the runtime. It always names the digest of the request it answers; a query for an id the owner never received is answered by `request_not_held`, so nothing a result says can sit beside a request nobody holds. A stored result cannot show that a model read, kept or obeyed a returned body.",
  "required": [
    "kind",
    "schema",
    "request_id",
    "request_digest",
    "local_effect",
    "provider_effect",
    "actual_stage",
    "outputs",
    "material_gaps",
    "supported_recovery"
  ],
  "properties": {
    "kind": {
      "const": "operation_result"
    },
    "schema": {
      "const": 1
    },
    "request_id": {
      "$ref": "#/$defs/request_id"
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "local_effect": {
      "enum": [
        "none",
        "private_state_written",
        "candidate_stored",
        "objects_staged",
        "committed"
      ]
    },
    "provider_effect": {
      "enum": [
        "not_applicable",
        "none",
        "queued",
        "dispatched",
        "committed",
        "unknown"
      ]
    },
    "actual_stage": {
      "enum": [
        "refused",
        "previewed",
        "draft",
        "in_review",
        "approved",
        "executing",
        "committed",
        "changes_requested",
        "rejected",
        "withdrawn",
        "expired",
        "stale",
        "blocked",
        "conflict",
        "partial",
        "unknown"
      ]
    },
    "outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "material_gaps": {
      "$ref": "#/$defs/gaps"
    },
    "supported_recovery": {
      "$ref": "#/$defs/recovery"
    }
  },
  "x-runtime-owned": true,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "acceptances_void_after_revision",
            "access_generation_moved",
            "access_locked",
            "access_not_established",
            "access_signed_out",
            "access_state_not_durable",
            "adoption_evidence_missing",
            "agent_not_owned_here",
            "answer_not_from_a_person",
            "answer_origin_unverified",
            "applicability_unstated",
            "approval_threshold_unmet",
            "approver_not_independent",
            "audience_mismatch",
            "backup_set_damaged",
            "backup_set_incomplete",
            "baseline_missing",
            "baseline_not_retained",
            "basis_cycle",
            "basis_target_missing",
            "binding_conflict",
            "binding_unverified",
            "body_missing",
            "bootstrap_already_committed",
            "budget_exhausted",
            "cancel_too_late",
            "capability_not_qualified",
            "child_route_unsupported",
            "choice_conflict_unresolved",
            "client_token_missing",
            "client_token_unknown",
            "companion_unavailable",
            "competing_successors",
            "condition_not_covered",
            "confirmation_is_not_authorization",
            "connection_profile_mismatch",
            "control_evidence_insufficient",
            "control_superseded",
            "credential_expired",
            "credential_missing",
            "credential_revoked",
            "cursor_basis_moved",
            "cursor_revoked",
            "custody_incomplete",
            "delegation_ceiling_exceeded",
            "delivery_unobserved",
            "destination_invented",
            "effect_class_mismatch",
            "erasure_not_promised",
            "executable_import_refused",
            "fixture_result_in_real_mode",
            "fork_evidence",
            "fresh_auth_required",
            "group_membership_escalation",
            "hidden_confirmation_refused",
            "host_not_exact",
            "host_not_qualified",
            "id_bound_to_other_bytes",
            "import_conflicting_bytes",
            "isolation_unproven",
            "journal_mode_unexpected",
            "last_owner_removal_refused",
            "lifecycle_contradiction",
            "local_origin_is_not_authority",
            "management_detour_refused",
            "manifest_member_unlisted",
            "navigation_changed_state",
            "object_digest_mismatch",
            "origin_not_exact",
            "origin_required",
            "outcome_partial",
            "outcome_unknown",
            "preference_invalidated",
            "preflight_refused",
            "private_key_beside_public",
            "proposal_self_authorized",
            "protected_root_bypass",
            "protocol_claim_only",
            "protocol_version_not_offered",
            "publisher_bytes_modified",
            "recipient_link_unknown",
            "recipient_mismatch",
            "ref_unavailable",
            "rehydration_needs_bodies",
            "removal_unconfirmed",
            "rendering_not_retained",
            "repository_binding_required",
            "request_id_conflict",
            "request_mismatch",
            "resume_stale",
            "resurrection_refused",
            "retention_declined",
            "retry_under_a_new_id_refused",
            "role_body_unavailable",
            "role_promotion_refused",
            "route_unsupported",
            "selection_unresolved",
            "semantics_unsupported",
            "signature_invalid",
            "signature_namespace_mismatch",
            "signer_not_permitted",
            "source_home_conflict",
            "source_not_authorized",
            "source_right_not_overridable",
            "stale_base",
            "state_proof_invalid",
            "state_proof_out_of_scope",
            "state_proof_stale",
            "storage_generation_reset",
            "succession_incomplete",
            "tool_absent",
            "trust_continuity_unverified",
            "unique_outbox_at_risk",
            "unlock_needs_a_terminal",
            "use_not_admitted",
            "wire_version_unsupported",
            "working_bytes_moved"
          ]
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/[^/]*)*$"
        }
      }
    },
    "gaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "recovery": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "retry_same_request",
          "query_same_request",
          "reseal_on_current_head",
          "unlock",
          "sign_in",
          "fresh_authentication",
          "enroll_credential",
          "refresh_control_evidence",
          "open_a_terminal",
          "new_governed_request"
        ]
      }
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{32}$"
    }
  }
}
