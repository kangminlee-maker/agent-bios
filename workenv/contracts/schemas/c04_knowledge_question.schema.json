{
  "type": "object",
  "additionalProperties": false,
  "title": "C04 knowledge question",
  "description": "A question with the conditions that can change its answer, against exact source revisions. A condition the sources do not cover yields a scoped unknown, never an answer with the condition dropped. `order` is an explicit layer order the worker chose; without one the order is repository, personal, Team. Choosing a layer chooses which answer to prefer, never which is true, and drops none.",
  "required": [
    "kind",
    "schema",
    "concern",
    "source_pins",
    "want"
  ],
  "properties": {
    "kind": {
      "const": "knowledge_question"
    },
    "schema": {
      "const": 1
    },
    "concern": {
      "$ref": "#/$defs/concern"
    },
    "source_pins": {
      "$ref": "#/$defs/source_pins"
    },
    "want": {
      "enum": [
        "body",
        "evidence",
        "both"
      ]
    },
    "companions": {
      "enum": [
        "required",
        "optional"
      ]
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scope"
      }
    }
  },
  "$defs": {
    "source_pins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source_pin"
      }
    },
    "source_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_digest"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "revision_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{32}$"
    },
    "concern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "value"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/repository_scope"
        },
        {
          "$ref": "#/$defs/personal_scope"
        },
        {
          "$ref": "#/$defs/team_scope"
        }
      ]
    },
    "personal_scope": {
      "additionalProperties": false,
      "properties": {
        "layer": {
          "const": "personal"
        },
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        }
      },
      "required": [
        "layer",
        "principal_id"
      ],
      "type": "object"
    },
    "repository_scope": {
      "additionalProperties": false,
      "properties": {
        "layer": {
          "const": "repository"
        },
        "repository_id": {
          "$ref": "#/$defs/repository_id"
        }
      },
      "required": [
        "layer",
        "repository_id"
      ],
      "type": "object"
    },
    "team_scope": {
      "additionalProperties": false,
      "properties": {
        "layer": {
          "const": "team"
        },
        "team_id": {
          "$ref": "#/$defs/team_id"
        }
      },
      "required": [
        "layer",
        "team_id"
      ],
      "type": "object"
    },
    "principal_id": {
      "pattern": "^prn_[0-9a-f]{32}$",
      "type": "string"
    },
    "repository_id": {
      "pattern": "^rep_[0-9a-f]{32}$",
      "type": "string"
    },
    "team_id": {
      "pattern": "^tem_[0-9a-f]{32}$",
      "type": "string"
    }
  }
}
