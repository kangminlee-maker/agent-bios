{
  "type": "object",
  "additionalProperties": false,
  "title": "C04 projection plan",
  "description": "What to project to a role: exact authorized sources, the recipient's view and the entrance the request arrived through. An entrance whose root the caller chose reaches protected bytes only through the one admission owner, which is why the plan carries it. `order` records an explicit composition order when the worker set one; its absence means the default repository, personal, Team.",
  "required": [
    "kind",
    "schema",
    "source_pins",
    "role",
    "recipient_view",
    "entrance"
  ],
  "properties": {
    "kind": {
      "const": "projection_plan"
    },
    "schema": {
      "const": 1
    },
    "source_pins": {
      "$ref": "#/$defs/source_pins"
    },
    "role": {
      "const": "instructions"
    },
    "recipient_view": {
      "enum": [
        "consumer",
        "contributor",
        "reviewer",
        "executor"
      ]
    },
    "entrance": {
      "$ref": "#/$defs/entrance"
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scope"
      }
    }
  },
  "$defs": {
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/repository_scope"
        },
        {
          "$ref": "#/$defs/personal_scope"
        },
        {
          "$ref": "#/$defs/team_scope"
        }
      ]
    },
    "team_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "team_id"
      ],
      "properties": {
        "layer": {
          "const": "team"
        },
        "team_id": {
          "$ref": "#/$defs/team_id"
        }
      }
    },
    "team_id": {
      "type": "string",
      "pattern": "^tem_[0-9a-f]{32}$"
    },
    "personal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "principal_id"
      ],
      "properties": {
        "layer": {
          "const": "personal"
        },
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        }
      }
    },
    "principal_id": {
      "type": "string",
      "pattern": "^prn_[0-9a-f]{32}$"
    },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "repository_id"
      ],
      "properties": {
        "layer": {
          "const": "repository"
        },
        "repository_id": {
          "$ref": "#/$defs/repository_id"
        }
      }
    },
    "repository_id": {
      "type": "string",
      "pattern": "^rep_[0-9a-f]{32}$"
    },
    "entrance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "root_origin"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "root_origin": {
          "enum": [
            "owner",
            "caller"
          ]
        }
      }
    },
    "source_pins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source_pin"
      }
    },
    "source_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_digest"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "revision_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{32}$"
    }
  }
}
