        "source.revision.commit",
        "source.revision.publish",
        "source.rights.set",
        "store.backup.create",
        "store.backup.restore",
        "surface.drive",
        "team.approval.record",
        "team.consent.record",
        "team.continuation.record",
        "team.device.forget",
        "team.device.retire",
        "team.found",
        "team.grant.change",
        "team.invitation.cancel",
        "team.invitation.issue",
        "team.lifecycle.apply",
        "team.membership.change",
        "team.membership.leave",
        "team.policy.set",
        "team.profile.set",
        "team.retention.apply",
        "team.state.read",
        "team.stewardship.transfer",
        "team.verification.record",
        "transfer.accept",
        "transfer.stage",
        "validation.run",
        "workstream.open"
      ]
    },
    "output_kind": {
      "enum": [
        "access_admission",
        "access_handle",
        "access_state",
        "action_assessment",
        "answer_evidence",
        "application_preference",
        "approval",
        "authority_continuity",
        "backup_set",
        "batch_result",
        "behaviour_capture",
        "bridge_response",
        "capability_probe",
        "capability_profile",
        "carrier_binding",
        "carrier_state",
        "choice_record",
        "collection",
        "comparison_basis",
        "contribution_return",
        "control_evidence",
        "custody_acknowledgment",
        "custody_commitment",
        "delivery_attempt",
        "delivery_observation",
        "derivation_map",
        "device_retirement",
