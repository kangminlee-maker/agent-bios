        "surface_trace",
        "team_profile",
        "team_state",
        "transfer_stage_record",
        "validation_run",
        "workstream"
      ]
    },
    "confirmed_stage": {
      "enum": [
        "committed",
        "refused",
        "previewed",
        "draft",
        "in_review",
        "approved",
        "executing",
        "changes_requested",
        "rejected",
        "withdrawn",
        "expired",
        "stale",
        "blocked",
        "conflict",
        "partial",
        "unknown"
      ]
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "description": "One recent request: the last stage its owner confirmed, when, and what that observation covered. `local_only` read this installation's owner alone; `local_and_provider` also read the provider's outcome.",
      "required": [
        "request_id",
        "request_digest",
        "operation",
        "confirmed_stage",
        "confirmed_at",
        "coverage",
        "recovery"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "confirmed_stage": {
          "$ref": "#/$defs/confirmed_stage"
        },
        "confirmed_at": {
          "$ref": "#/$defs/instant"
        },
        "coverage": {
          "enum": [
            "local_only",
            "local_and_provider"
          ]
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        }
      }
    },
    "history_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "description": "A dated checkpoint: a record this scope accepted, and any note recorded with it then. The note is history — a next step somebody wrote down — never the current request.",
      "required": [
        "digest",
        "kind",
        "recorded_at"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "$ref": "#/$defs/output_kind"
        },
        "recorded_at": {
          "$ref": "#/$defs/instant"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
