        "preparation.assess",
        "preparation.compose",
        "reader.body.read",
        "reader.question.answer",
        "reader.use.resume",
        "recipient.answer.record",
        "recipient.delivery.attempt",
        "recipient.link.open",
        "reference.resolve",
        "removal.execute",
        "repository.bind",
        "retention.derivations.read",
        "retention.plan.set",
        "role.project",
        "route.offer",
        "route.select",
        "session.routing.activate",
        "source.capture.record",
        "source.home.register",
        "source.observe",
