{
  "type": "object",
  "additionalProperties": false,
  "title": "C09 transfer envelope",
  "description": "What a package binds: whose authority it comes from, which namespace, which recipient may open it, exactly what is inside with sizes and digests, and what it needs to already be there. Trust comes from enrolment or verified authority continuity, named here by digest — never from a key the package carries about itself, which is why there is no field for one. Signing is not encryption, so confidentiality is stated separately. Each member is named by its path in the package, its digest and size, and what it is: a declared record kind, or `source_member` for a source revision's own file. A path is relative and each segment starts with a letter, digit or underscore, so a member that would climb out of the package has no spelling; two members at one path are refused.",
  "required": [
    "kind",
    "schema",
    "authority",
    "namespace",
    "recipient",
    "completeness",
    "inventory",
    "prerequisites",
    "semantics",
    "continuity_evidence_digests",
    "confidentiality"
  ],
  "x-unique-by": {
    "key": "path",
    "across": [
      "inventory"
    ]
  },
  "properties": {
    "kind": {
      "const": "transfer_envelope"
    },
    "schema": {
      "const": 1
    },
    "authority": {
      "$ref": "#/$defs/scope"
    },
    "namespace": {
      "$ref": "#/$defs/scope"
    },
    "recipient": {
      "$ref": "#/$defs/transfer_recipient"
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/transfer_member"
      }
    },
    "prerequisites": {
      "$ref": "#/$defs/digests"
    },
    "semantics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/semantic"
      }
    },
    "continuity_evidence_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "confidentiality": {
      "enum": [
        "none",
        "in_transport",
        "at_rest"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{32}$"
    },
    "source_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "checkpoint_digest"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "checkpoint_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "source_id": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{32}$"
    },
    "principal_id": {
      "type": "string",
      "pattern": "^prn_[0-9a-f]{32}$"
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/repository_scope"
        },
        {
          "$ref": "#/$defs/personal_scope"
        },
        {
          "$ref": "#/$defs/team_scope"
        }
      ]
    },
    "team_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "team_id"
      ],
      "properties": {
        "layer": {
          "const": "team"
        },
        "team_id": {
          "$ref": "#/$defs/team_id"
        }
      }
    },
    "team_id": {
      "type": "string",
      "pattern": "^tem_[0-9a-f]{32}$"
    },
    "personal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "principal_id"
      ],
      "properties": {
        "layer": {
          "const": "personal"
        },
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        }
      }
    },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "repository_id"
      ],
      "properties": {
        "layer": {
          "const": "repository"
        },
        "repository_id": {
          "$ref": "#/$defs/repository_id"
        }
      }
    },
    "repository_id": {
      "type": "string",
      "pattern": "^rep_[0-9a-f]{32}$"
    },
    "digests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "transfer_recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted_scope"
      ],
      "properties": {
        "permitted_scope": {
          "$ref": "#/$defs/scope"
        },
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        }
      }
    },
    "complete_transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carries"
      ],
      "properties": {
        "carries": {
          "const": "complete"
        }
      }
    },
    "incremental_transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carries",
        "baseline",
        "acknowledged_inventory_digest"
      ],
      "properties": {
        "carries": {
          "const": "incremental"
        },
        "baseline": {
          "$ref": "#/$defs/source_frontier"
        },
        "acknowledged_inventory_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "return_transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carries",
        "for_request_id"
      ],
      "properties": {
        "carries": {
          "const": "return"
        },
        "for_request_id": {
          "$ref": "#/$defs/request_id"
        }
      }
    },
    "completeness": {
      "oneOf": [
        {
          "$ref": "#/$defs/complete_transfer"
        },
        {
          "$ref": "#/$defs/incremental_transfer"
        },
        {
          "$ref": "#/$defs/return_transfer"
        }
      ]
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
    },
    "object_kind": {
      "enum": [
        "access_admission",
        "access_state",
        "access_transition",
        "action_assessment",
        "answer_evidence",
        "application_preference",
        "approval",
        "authority_continuity",
        "backup_set",
        "batch_plan",
        "batch_result",
        "behaviour_capture",
        "bridge_binding",
        "bridge_request",
        "bridge_response",
        "capability_probe",
        "capability_profile",
        "carrier_binding",
        "carrier_request",
        "carrier_state",
        "choice_record",
        "collection",
        "comparison_basis",
        "contribution_return",
        "control_evidence",
        "custody_acknowledgment",
        "custody_commitment",
        "cutover_plan",
        "delivery_attempt",
        "delivery_observation",
        "derivation_map",
        "derivation_query",
        "device_retirement",
        "entrance_disposition",
        "environment_adoption",
        "environment_edition",
        "exposure_trial",
        "extraction_run",
        "form_profile",
        "founding_proposal",
        "governing_policy",
        "grant_record",
        "history_query",
        "host_binding",
        "host_reply",
        "invitation_cancellation",
        "knowledge_capture",
        "knowledge_model",
        "knowledge_question",
        "knowledge_view",
        "lifecycle_action",
        "lifecycle_event",
        "local_profile",
        "membership_consent",
        "membership_invitation",
        "membership_record",
        "memory_candidate",
        "memory_capture",
        "operation_query",
        "operation_receipt",
        "operation_request",
        "operation_result",
        "package_candidate",
        "pending_question",
        "preparation",
        "preparation_request",
        "principal_binding",
        "profile_label",
        "projection_plan",
        "provider_callback",
        "provider_connection",
        "qualified_state",
        "reader_envelope",
        "reader_result",
        "recent_history",
        "recipient_link",
        "removal_outcome",
        "removal_request",
        "repository_binding",
        "request_not_held",
        "restore_report",
        "resume_request",
        "retention_plan",
        "role_projection",
        "route_offer",
        "route_outcome",
        "route_selection",
        "session_activation",
        "session_routing",
        "sign_in_attempt",
        "sign_in_evidence",
        "signature_binding",
        "signature_envelope",
        "source_home",
        "source_manifest",
        "source_member",
        "source_observation",
        "source_provenance",
        "source_ref",
        "source_request",
        "source_rights",
        "source_selection",
        "state_proof",
        "state_question",
        "stewardship_transfer",
        "storage_binding",
        "study_protocol",
        "surface_observation",
        "surface_script",
        "surface_trace",
        "team_profile",
        "team_state",
        "transfer_envelope",
        "transfer_stage_record",
        "unlock_binding",
        "validation_request",
        "validation_run",
        "workstream"
      ]
    },
    "transfer_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "size",
        "object_kind"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/source_path"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "object_kind": {
          "$ref": "#/$defs/object_kind"
        }
      }
    }
  }
}
