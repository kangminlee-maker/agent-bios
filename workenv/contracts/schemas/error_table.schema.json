{
  "title": "Contract error table",
  "description": "Generated from the contract modules. One row per code; a code has one owning module.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "errors"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "owner",
          "meaning"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
