{
  "type": "object",
  "additionalProperties": false,
  "title": "C07 preparation request",
  "description": "Three questions are asked separately and answered separately: which sources this is composed from, what operation is declared, and \u2014 only when a task has actually been requested \u2014 what that task needs. A session that starts without a request carries no `work_request`, and its support is not assessed rather than assessed as satisfied.",
  "required": [
    "kind",
    "schema",
    "basis",
    "declared_operation"
  ],
  "properties": {
    "kind": {
      "const": "preparation_request"
    },
    "schema": {
      "const": 1
    },
    "basis": {
      "$ref": "#/$defs/preparation_basis"
    },
    "declared_operation": {
      "$ref": "#/$defs/declared_operation"
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scope"
      }
    },
    "work_request": {
      "$ref": "#/$defs/work_request"
    }
  },
  "$defs": {
    "subject_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "source_id"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "source_id": {
          "$ref": "#/$defs/source_id"
        }
      }
    },
    "source_id": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{32}$"
    },
    "role": {
      "enum": [
        "instructions",
        "knowledge",
        "memory"
      ]
    },
    "concern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "value"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "action": {
      "enum": [
        "local_profile",
        "read",
        "use",
        "contribute",
        "review",
        "publish",
        "adopt",
        "decide",
        "grant",
        "policy",
        "transfer",
        "suspend",
        "retain_delete",
        "export"
      ]
    },
    "source_pins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source_pin"
      }
    },
    "source_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_digest"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "revision_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/repository_scope"
        },
        {
          "$ref": "#/$defs/personal_scope"
        },
        {
          "$ref": "#/$defs/team_scope"
        }
      ]
    },
    "team_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "team_id"
      ],
      "properties": {
        "layer": {
          "const": "team"
        },
        "team_id": {
          "$ref": "#/$defs/team_id"
        }
      }
    },
    "team_id": {
      "type": "string",
      "pattern": "^tem_[0-9a-f]{32}$"
    },
    "personal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "principal_id"
      ],
      "properties": {
        "layer": {
          "const": "personal"
        },
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        }
      }
    },
    "principal_id": {
      "type": "string",
      "pattern": "^prn_[0-9a-f]{32}$"
    },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "repository_id"
      ],
      "properties": {
        "layer": {
          "const": "repository"
        },
        "repository_id": {
          "$ref": "#/$defs/repository_id"
        }
      }
    },
    "repository_id": {
      "type": "string",
      "pattern": "^rep_[0-9a-f]{32}$"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^env_[0-9a-f]{32}$"
    },
    "adopted_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "environment_id",
        "adoption_evidence_digest"
      ],
      "properties": {
        "from": {
          "const": "environment"
        },
        "environment_id": {
          "$ref": "#/$defs/environment_id"
        },
        "adoption_evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "ad_hoc_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "scopes",
        "source_pins"
      ],
      "properties": {
        "from": {
          "const": "ad_hoc"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scope"
          }
        },
        "source_pins": {
          "$ref": "#/$defs/source_pins"
        }
      }
    },
    "preparation_basis": {
      "oneOf": [
        {
          "$ref": "#/$defs/adopted_basis"
        },
        {
          "$ref": "#/$defs/ad_hoc_basis"
        }
      ]
    },
    "declared_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "action"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "work_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concern"
      ],
      "properties": {
        "concern": {
          "$ref": "#/$defs/concern"
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/subject_ref"
          }
        }
      }
    }
  }
}
