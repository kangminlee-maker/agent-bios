{
  "title": "C03 package candidate",
  "description": "One immutable candidate package built from one commit of the integrated source: its tarball, and every member with the source path it was copied from or the fact that it was made at pack time. That per-member origin is the source-to-package mapping, so a member with no source and no pack-time origin cannot be listed. A cutover names the candidate it installs by this record's digest; the required object closure is held over these members by the package gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema",
    "source_commit",
    "tarball",
    "members"
  ],
  "x-unique-by": {
    "key": "path",
    "across": [
      "members"
    ]
  },
  "properties": {
    "kind": {
      "const": "package_candidate"
    },
    "schema": {
      "const": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The commit of the integrated source it was built from."
    },
    "tarball": {
      "$ref": "#/$defs/tarball"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package_member"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
    },
    "tarball": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "package_member": {
      "type": "object",
      "additionalProperties": false,
      "description": "One file of the package: where it sits, its bytes, and where they came from.",
      "required": [
        "path",
        "digest",
        "size",
        "origin"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/source_path"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "origin": {
          "$ref": "#/$defs/member_origin"
        }
      }
    },
    "member_origin": {
      "oneOf": [
        {
          "$ref": "#/$defs/copied_member"
        },
        {
          "$ref": "#/$defs/made_at_pack_time"
        }
      ]
    },
    "copied_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copied_from"
      ],
      "properties": {
        "copied_from": {
          "$ref": "#/$defs/source_path"
        }
      }
    },
    "made_at_pack_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "made"
      ],
      "properties": {
        "made": {
          "const": "at_pack_time"
        }
      }
    }
  }
}
