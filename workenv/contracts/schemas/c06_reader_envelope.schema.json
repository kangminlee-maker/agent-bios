{
  "type": "object",
  "additionalProperties": false,
  "title": "C06 reader envelope",
  "description": "One envelope for all three roles: what work this is for, which subjects are required, the reader's role and view, what is being asked, and a budget. `retains` is the caller's own declaration that it still holds a body and its qualifications, which is the only thing that lets the answer leave that body out; a digest or a past receipt is not that declaration. The budget bounds what may be examined as well as what may be returned, and `history` says whether superseded and withdrawn material is asked for. `candidates` selects the person's own memory candidates by exact version, which come back as support nobody has accepted.",
  "required": [
    "kind",
    "schema",
    "work_scope",
    "required",
    "role_view",
    "selector",
    "budget",
    "history"
  ],
  "properties": {
    "kind": {
      "const": "reader_envelope"
    },
    "schema": {
      "const": 1
    },
    "work_scope": {
      "$ref": "#/$defs/scope"
    },
    "required": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/subject_ref"
      }
    },
    "role_view": {
      "$ref": "#/$defs/role_view"
    },
    "selector": {
      "$ref": "#/$defs/selector"
    },
    "continuation": {
      "$ref": "#/$defs/continuation"
    },
    "retains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/retained_claim"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/candidate_version"
      },
      "description": "The person's own memory candidates this work may use as support, each at an exact version. Selecting one neither publishes nor adopts it."
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "history": {
      "enum": [
        "excluded",
        "included"
      ],
      "description": "Whether superseded and withdrawn material is asked for, or only what is current."
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^unt_[0-9a-f]{32}$"
    },
    "concern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "value"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor_digest",
        "frontiers"
      ],
      "properties": {
        "cursor_digest": {
          "$ref": "#/$defs/digest"
        },
        "frontiers": {
          "$ref": "#/$defs/frontiers"
        }
      }
    },
    "frontiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source_frontier"
      }
    },
    "source_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "checkpoint_digest"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "checkpoint_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "source_id": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{32}$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "description": "Two bounds: how much the reader may examine, and how much it may return. Bounding what is examined is what keeps retrieval finite; clipping only what is returned is not that bound.",
      "required": [
        "max_examined",
        "max_units"
      ],
      "properties": {
        "max_examined": {
          "type": "integer",
          "minimum": 1
        },
        "max_units": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "role_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "view"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "view": {
          "enum": [
            "consumer",
            "contributor",
            "reviewer",
            "executor"
          ]
        }
      }
    },
    "role": {
      "enum": [
        "instructions",
        "knowledge",
        "memory"
      ]
    },
    "subject_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "source_id"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "source_id": {
          "$ref": "#/$defs/source_id"
        }
      }
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/repository_scope"
        },
        {
          "$ref": "#/$defs/personal_scope"
        },
        {
          "$ref": "#/$defs/team_scope"
        }
      ]
    },
    "team_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "team_id"
      ],
      "properties": {
        "layer": {
          "const": "team"
        },
        "team_id": {
          "$ref": "#/$defs/team_id"
        }
      }
    },
    "team_id": {
      "type": "string",
      "pattern": "^tem_[0-9a-f]{32}$"
    },
    "personal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "principal_id"
      ],
      "properties": {
        "layer": {
          "const": "personal"
        },
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        }
      }
    },
    "principal_id": {
      "type": "string",
      "pattern": "^prn_[0-9a-f]{32}$"
    },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "repository_id"
      ],
      "properties": {
        "layer": {
          "const": "repository"
        },
        "repository_id": {
          "$ref": "#/$defs/repository_id"
        }
      }
    },
    "repository_id": {
      "type": "string",
      "pattern": "^rep_[0-9a-f]{32}$"
    },
    "concern_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asks",
        "concern"
      ],
      "properties": {
        "asks": {
          "const": "concern"
        },
        "concern": {
          "$ref": "#/$defs/concern"
        }
      }
    },
    "exact_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asks",
        "unit_ids"
      ],
      "properties": {
        "asks": {
          "const": "exact"
        },
        "unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/unit_id"
          }
        }
      }
    },
    "selector": {
      "oneOf": [
        {
          "$ref": "#/$defs/concern_selector"
        },
        {
          "$ref": "#/$defs/exact_selector"
        }
      ]
    },
    "retained_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "body_digest",
        "qualifications_digest"
      ],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/unit_id"
        },
        "body_digest": {
          "$ref": "#/$defs/digest"
        },
        "qualifications_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "candidate_version": {
      "type": "object",
      "additionalProperties": false,
      "description": "One version of a memory candidate, by its id and version number.",
      "required": [
        "candidate_id",
        "version"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^cnd_[0-9a-f]{32}$"
    }
  }
}
