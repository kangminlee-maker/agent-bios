{
  "title": "C03 history query",
  "description": "Ask one scope's owners what happened recently, and how much of it to return.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema",
    "scope",
    "limit"
  ],
  "properties": {
    "kind": {
      "const": "history_query"
    },
    "schema": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "$defs": {
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/repository_scope"
        },
        {
          "$ref": "#/$defs/personal_scope"
        },
        {
          "$ref": "#/$defs/team_scope"
        }
      ]
    },
    "team_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "team_id"
      ],
      "properties": {
        "layer": {
          "const": "team"
        },
        "team_id": {
          "$ref": "#/$defs/team_id"
        }
      }
    },
    "team_id": {
      "type": "string",
      "pattern": "^tem_[0-9a-f]{32}$"
    },
    "personal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "principal_id"
      ],
      "properties": {
        "layer": {
          "const": "personal"
        },
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        }
      }
    },
    "principal_id": {
      "type": "string",
      "pattern": "^prn_[0-9a-f]{32}$"
    },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "repository_id"
      ],
      "properties": {
        "layer": {
          "const": "repository"
        },
        "repository_id": {
          "$ref": "#/$defs/repository_id"
        }
      }
    },
    "repository_id": {
      "type": "string",
      "pattern": "^rep_[0-9a-f]{32}$"
    }
  }
}
