{
  "title": "C03 batch result",
  "description": "What each item of one batch actually did, written by the runtime. An item is committed with its receipt, refused with its gaps, unknown, or withheld because another item its carrier commits with it did not commit. There is no summary field, so a denial or an unknown cannot be folded into a count.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema",
    "plan_digest",
    "items"
  ],
  "x-unique-by": {
    "key": "request_digest",
    "across": [
      "items"
    ]
  },
  "x-runtime-owned": true,
  "properties": {
    "kind": {
      "const": "batch_result"
    },
    "schema": {
      "const": 1
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item_result"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "carrier": {
      "enum": [
        "local",
        "peer",
        "github",
        "package"
      ],
      "description": "The carrier that commits: this installation's own store, a peer, a GitHub exchange repository, or a package."
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{32}$"
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "acceptances_void_after_revision",
            "access_generation_moved",
            "access_locked",
            "access_not_established",
            "access_signed_out",
            "access_state_not_durable",
            "adapter_unavailable",
            "adoption_evidence_missing",
            "agent_not_owned_here",
            "alternative_not_offered",
            "answer_not_from_a_person",
            "answer_origin_unverified",
            "applicability_unstated",
            "approval_threshold_unmet",
            "approver_not_independent",
            "audience_mismatch",
            "author_side_member",
            "backup_set_damaged",
            "backup_set_incomplete",
            "baseline_missing",
            "baseline_not_retained",
            "basis_cycle",
            "basis_target_missing",
            "binding_conflict",
            "binding_unverified",
            "body_missing",
            "bootstrap_already_committed",
            "budget_exhausted",
            "callback_not_bound",
            "cancel_too_late",
            "candidate_not_registered",
            "candidate_origin_changed",
            "capability_not_qualified",
            "carrier_repository_mismatch",
            "carrier_unreachable",
            "child_route_unsupported",
            "choice_conflict_unresolved",
            "claim_not_admitted",
            "claim_not_expected",
            "client_token_missing",
            "client_token_unknown",
            "companion_unavailable",
            "comparison_incomplete",
            "competing_successors",
            "condition_not_covered",
            "confirmation_is_not_authorization",
            "connection_profile_mismatch",
            "control_evidence_insufficient",
            "control_superseded",
            "credential_expired",
            "credential_missing",
            "credential_revoked",
            "cursor_basis_moved",
            "cursor_revoked",
            "custody_incomplete",
            "cutover_source_moved",
            "delegation_ceiling_exceeded",
            "delivery_unobserved",
            "destination_invented",
            "effect_class_mismatch",
            "erasure_not_promised",
            "evidence_already_recorded",
            "executable_import_refused",
            "finalizer_unavailable",
            "fixture_result_in_real_mode",
            "fork_evidence",
            "form_mapping_invalid",
            "fresh_auth_required",
            "grant_not_held",
            "group_membership_escalation",
            "hidden_confirmation_refused",
            "host_not_exact",
            "host_not_qualified",
            "id_bound_to_other_bytes",
            "import_conflicting_bytes",
            "input_not_observed",
            "input_not_permitted",
            "invitation_not_open",
            "isolation_unproven",
            "journal_mode_unexpected",
            "keystore_missing",
            "knowledge_evidence_conflicts",
            "last_owner_removal_refused",
            "lifecycle_contradiction",
            "local_origin_is_not_authority",
            "management_detour_refused",
            "manifest_member_unlisted",
            "model_reference_dangling",
            "navigation_changed_state",
            "object_digest_mismatch",
            "origin_not_exact",
            "origin_required",
            "outcome_partial",
            "outcome_unknown",
            "payload_not_taken",
            "policy_superseded",
            "preference_invalidated",
            "preflight_refused",
            "private_key_beside_public",
            "proposal_self_authorized",
            "protected_root_bypass",
            "protocol_claim_only",
            "protocol_version_not_offered",
            "provider_unreachable",
            "provisioning_in_doubt",
            "publisher_bytes_modified",
            "recipient_link_unknown",
            "recipient_mismatch",
            "ref_unavailable",
            "rehydration_needs_bodies",
            "removal_held",
            "removal_unconfirmed",
            "rendering_not_retained",
            "repository_binding_required",
            "repository_rights_not_a_grant",
            "request_id_conflict",
            "request_mismatch",
            "resubmitted_while_unknown",
            "resume_stale",
            "resurrection_refused",
            "retention_declined",
            "retry_under_a_new_id_refused",
            "role_body_unavailable",
            "role_promotion_refused",
            "route_retired",
            "route_unsupported",
            "runtime_path_missing",
            "same_layer_unordered",
            "selection_unresolved",
            "semantics_unsupported",
            "signature_invalid",
            "signature_namespace_mismatch",
            "signer_not_permitted",
            "source_home_conflict",
            "source_not_authorized",
            "source_right_not_overridable",
            "stale_base",
            "state_proof_invalid",
            "state_proof_out_of_scope",
            "state_proof_stale",
            "storage_generation_reset",
            "storage_not_encrypted",
            "succession_incomplete",
            "team_archived",
            "team_terminal",
            "tool_absent",
            "trust_continuity_unverified",
            "unique_outbox_at_risk",
            "unlock_needs_a_terminal",
            "use_not_admitted",
            "widening_unstated",
            "wire_version_unsupported",
            "working_bytes_moved"
          ]
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/[^/]*)*$"
        }
      }
    },
    "item_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_digest",
        "carrier",
        "outcome"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "carrier": {
          "$ref": "#/$defs/carrier"
        },
        "outcome": {
          "$ref": "#/$defs/item_outcome"
        }
      }
    },
    "item_outcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/committed_item"
        },
        {
          "$ref": "#/$defs/refused_item"
        },
        {
          "$ref": "#/$defs/unsettled_item"
        }
      ]
    },
    "committed_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is",
        "receipt_digest"
      ],
      "properties": {
        "is": {
          "const": "committed"
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "refused_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is",
        "material_gaps"
      ],
      "properties": {
        "is": {
          "const": "refused"
        },
        "material_gaps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      }
    },
    "unsettled_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is"
      ],
      "description": "`unknown`: the item's outcome is not known; ask again under its own request id. `withheld`: another item its carrier commits with it did not commit, so neither did this one.",
      "properties": {
        "is": {
          "enum": [
            "unknown",
            "withheld"
          ]
        }
      }
    }
  }
}
