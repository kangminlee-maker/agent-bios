{
  "type": "object",
  "additionalProperties": false,
  "title": "C01 source request",
  "description": "What was asked for: this role, in this home, by one of three routes. It carries no id and no time because it is the payload of a C03 operation request, which owns both.",
  "required": [
    "kind",
    "schema",
    "role",
    "destination",
    "route"
  ],
  "properties": {
    "kind": {
      "const": "source_request"
    },
    "schema": {
      "const": 1
    },
    "role": {
      "$ref": "#/$defs/role"
    },
    "destination": {
      "$ref": "#/$defs/source_destination"
    },
    "route": {
      "$ref": "#/$defs/route"
    }
  },
  "$defs": {
    "route": {
      "oneOf": [
        {
          "$ref": "#/$defs/add_published_route"
        },
        {
          "$ref": "#/$defs/import_external_route"
        },
        {
          "$ref": "#/$defs/author_here_route"
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{32}$"
    },
    "author_here_route": {
      "type": "object",
      "additionalProperties": false,
      "description": "A revision authored on this installation. The request carries the source_manifest it submits, and this names it by digest: its members by path, digest and size, whose bytes come with the request or, for a repository-authored destination, from the bound checkout. The owner stores that manifest with the time it produced it, so the revision digest is not this one.",
      "required": [
        "route",
        "manifest_digest"
      ],
      "properties": {
        "route": {
          "const": "author_here"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "import_external_route": {
      "type": "object",
      "additionalProperties": false,
      "description": "An external package states its origin and its conditions, because nothing else in this installation knows them.",
      "required": [
        "route",
        "declared_origin",
        "license_conditions",
        "revision_digest"
      ],
      "properties": {
        "route": {
          "const": "import_external_package"
        },
        "declared_origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "license_conditions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "revision_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "add_published_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "package_id",
        "revision_digest"
      ],
      "properties": {
        "route": {
          "const": "add_published_package"
        },
        "package_id": {
          "$ref": "#/$defs/package_id"
        },
        "revision_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "package_id": {
      "type": "string",
      "pattern": "^pkg_[0-9a-f]{32}$"
    },
    "source_destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "home_mode"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "home_mode": {
          "enum": [
            "package_published",
            "repository_authored",
            "managed"
          ]
        }
      }
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/repository_scope"
        },
        {
          "$ref": "#/$defs/personal_scope"
        },
        {
          "$ref": "#/$defs/team_scope"
        }
      ]
    },
    "team_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "team_id"
      ],
      "properties": {
        "layer": {
          "const": "team"
        },
        "team_id": {
          "$ref": "#/$defs/team_id"
        }
      }
    },
    "team_id": {
      "type": "string",
      "pattern": "^tem_[0-9a-f]{32}$"
    },
    "personal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "principal_id"
      ],
      "properties": {
        "layer": {
          "const": "personal"
        },
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        }
      }
    },
    "principal_id": {
      "type": "string",
      "pattern": "^prn_[0-9a-f]{32}$"
    },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "repository_id"
      ],
      "properties": {
        "layer": {
          "const": "repository"
        },
        "repository_id": {
          "$ref": "#/$defs/repository_id"
        }
      }
    },
    "repository_id": {
      "type": "string",
      "pattern": "^rep_[0-9a-f]{32}$"
    },
    "role": {
      "enum": [
        "instructions",
        "knowledge",
        "memory"
      ]
    }
  }
}
