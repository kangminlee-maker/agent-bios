{
  "title": "C04 session activation",
  "description": "Activate one session on its host with one preparation. Activation is explicit: a session that is never activated sends no request, and the runtime records it as selected only. What the session then received is the `session_routing` the activation is answered with.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema",
    "session",
    "preparation_digest"
  ],
  "properties": {
    "kind": {
      "const": "session_activation"
    },
    "schema": {
      "const": 1
    },
    "session": {
      "$ref": "#/$defs/routed_session"
    },
    "preparation_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "routed_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "profile_id"
      ],
      "properties": {
        "host": {
          "$ref": "#/$defs/client_binding"
        },
        "profile_id": {
          "$ref": "#/$defs/profile_id"
        }
      }
    },
    "client_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      }
    },
    "profile_id": {
      "type": "string",
      "pattern": "^prf_[0-9a-f]{32}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
