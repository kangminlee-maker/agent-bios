{
  "type": "object",
  "additionalProperties": false,
  "title": "C10 retention plan",
  "description": "Promised bodies and evictable cache are two lists, not one with a flag. That separation is the whole point: when space runs out the answer is to decline the promise, which is an outcome somebody sees, rather than to evict a body that was promised, which is an outcome nobody sees.",
  "required": [
    "kind",
    "schema",
    "scope",
    "promised",
    "evictable",
    "cleanup"
  ],
  "properties": {
    "kind": {
      "const": "retention_plan"
    },
    "schema": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "promised": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/inventory_entry"
      }
    },
    "evictable": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/inventory_entry"
      }
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inventory_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size",
        "object_kind"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "object_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        }
      }
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/repository_scope"
        },
        {
          "$ref": "#/$defs/personal_scope"
        },
        {
          "$ref": "#/$defs/team_scope"
        }
      ]
    },
    "team_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "team_id"
      ],
      "properties": {
        "layer": {
          "const": "team"
        },
        "team_id": {
          "$ref": "#/$defs/team_id"
        }
      }
    },
    "team_id": {
      "type": "string",
      "pattern": "^tem_[0-9a-f]{32}$"
    },
    "personal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "principal_id"
      ],
      "properties": {
        "layer": {
          "const": "personal"
        },
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        }
      }
    },
    "principal_id": {
      "type": "string",
      "pattern": "^prn_[0-9a-f]{32}$"
    },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "repository_id"
      ],
      "properties": {
        "layer": {
          "const": "repository"
        },
        "repository_id": {
          "$ref": "#/$defs/repository_id"
        }
      }
    },
    "repository_id": {
      "type": "string",
      "pattern": "^rep_[0-9a-f]{32}$"
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removes",
        "governed_by"
      ],
      "properties": {
        "removes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source_cache",
              "derived_index",
              "excerpt",
              "export"
            ]
          }
        },
        "governed_by": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "x-unique-by": {
    "key": "digest",
    "across": [
      "promised",
      "evictable"
    ]
  }
}
