{
  "type": "object",
  "additionalProperties": false,
  "title": "C10 retention plan",
  "description": "Promised bodies and evictable cache are two lists, not one with a flag. That separation is the whole point: when space runs out the answer is to decline the promise, which is an outcome somebody sees, rather than to evict a body that was promised, which is an outcome nobody sees. Cleanup names what it removes: caches, indexes, excerpts and exports, and the retained candidates and prompts captured material left behind.",
  "required": [
    "kind",
    "schema",
    "scope",
    "promised",
    "evictable",
    "cleanup"
  ],
  "properties": {
    "kind": {
      "const": "retention_plan"
    },
    "schema": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "promised": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/inventory_entry"
      }
    },
    "evictable": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evictable_entry"
      }
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inventory_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size",
        "object_kind"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "object_kind": {
          "$ref": "#/$defs/object_kind"
        }
      }
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/repository_scope"
        },
        {
          "$ref": "#/$defs/personal_scope"
        },
        {
          "$ref": "#/$defs/team_scope"
        }
      ]
    },
    "team_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "team_id"
      ],
      "properties": {
        "layer": {
          "const": "team"
        },
        "team_id": {
          "$ref": "#/$defs/team_id"
        }
      }
    },
    "team_id": {
      "type": "string",
      "pattern": "^tem_[0-9a-f]{32}$"
    },
    "personal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "principal_id"
      ],
      "properties": {
        "layer": {
          "const": "personal"
        },
        "principal_id": {
          "$ref": "#/$defs/principal_id"
        }
      }
    },
    "principal_id": {
      "type": "string",
      "pattern": "^prn_[0-9a-f]{32}$"
    },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "repository_id"
      ],
      "properties": {
        "layer": {
          "const": "repository"
        },
        "repository_id": {
          "$ref": "#/$defs/repository_id"
        }
      }
    },
    "repository_id": {
      "type": "string",
      "pattern": "^rep_[0-9a-f]{32}$"
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removes",
        "governed_by"
      ],
      "properties": {
        "removes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source_cache",
              "derived_index",
              "excerpt",
              "export",
              "candidate",
              "prompt"
            ]
          }
        },
        "governed_by": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evictable_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size",
        "object_kind"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "object_kind": {
          "enum": [
            "source_cache",
            "derived_index",
            "excerpt",
            "export"
          ]
        }
      },
      "description": "Only what can be rebuilt may be evicted: drafts, outboxes and sequencing state need backup and recovery instead."
    },
    "object_kind": {
      "enum": [
        "access_admission",
        "access_state",
        "access_transition",
        "action_assessment",
        "answer_evidence",
        "application_preference",
        "approval",
        "authority_continuity",
        "backup_set",
        "batch_plan",
        "batch_result",
        "behaviour_capture",
        "bridge_binding",
        "bridge_request",
        "bridge_response",
        "capability_probe",
        "capability_profile",
        "carrier_binding",
        "carrier_request",
        "carrier_state",
        "choice_record",
        "collection",
        "comparison_basis",
        "contribution_return",
        "control_evidence",
        "custody_acknowledgment",
        "custody_commitment",
        "cutover_plan",
        "delivery_attempt",
        "delivery_observation",
        "derivation_map",
        "derivation_query",
        "device_retirement",
        "entrance_disposition",
        "environment_adoption",
        "environment_edition",
        "exposure_trial",
        "extraction_run",
        "form_profile",
        "founding_proposal",
        "governing_policy",
        "grant_record",
        "history_query",
        "host_binding",
        "host_reply",
        "invitation_cancellation",
        "knowledge_capture",
        "knowledge_model",
        "knowledge_question",
        "knowledge_view",
        "lifecycle_action",
        "lifecycle_event",
        "local_profile",
        "membership_consent",
        "membership_invitation",
        "membership_record",
        "memory_candidate",
        "memory_capture",
        "operation_query",
        "operation_receipt",
        "operation_request",
        "operation_result",
        "package_candidate",
        "pending_question",
        "preparation",
        "preparation_request",
        "principal_binding",
        "profile_label",
        "projection_plan",
        "provider_callback",
        "provider_connection",
        "qualified_state",
        "reader_envelope",
        "reader_result",
        "recent_history",
        "recipient_link",
        "removal_outcome",
        "removal_request",
        "repository_binding",
        "request_not_held",
        "restore_report",
        "resume_request",
        "retention_plan",
        "role_projection",
        "route_offer",
        "route_outcome",
        "route_selection",
        "session_activation",
        "session_routing",
        "sign_in_attempt",
        "sign_in_evidence",
        "signature_binding",
        "signature_envelope",
        "source_home",
        "source_manifest",
        "source_member",
        "source_observation",
        "source_provenance",
        "source_ref",
        "source_request",
        "source_rights",
        "source_selection",
        "state_proof",
        "state_question",
        "stewardship_transfer",
        "storage_binding",
        "study_protocol",
        "surface_observation",
        "surface_script",
        "surface_trace",
        "team_profile",
        "team_state",
        "transfer_envelope",
        "transfer_stage_record",
        "unlock_binding",
        "validation_request",
        "validation_run",
        "workstream"
      ]
    }
  },
  "x-unique-by": {
    "key": "digest",
    "across": [
      "promised",
      "evictable"
    ]
  }
}
