    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/session_activation_4">
        <rdfs:label>session-activation.4</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Backend"/>
        <rdfs:comment>step 4 of session-activation: record activation intent and native source identity then invoke the native host and bind its observed session identifier</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>StateArtifact</ont:fromEntityId>
        <ont:toEntityId>Backend</ont:toEntityId>
