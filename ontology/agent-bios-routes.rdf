        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Migration"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/UserOwnedFileRegion"/>
        <rdfs:comment>step 2 of migrate: pin the release and capture bounded legacy inputs then remove only recognized owned native spans and files</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Migration</ont:fromEntityId>
        <ont:toEntityId>UserOwnedFileRegion</ont:toEntityId>
