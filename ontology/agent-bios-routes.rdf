        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsAssembler"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Host"/>
        <rdfs:comment>step 2 of session-activation: compile and verify the immutable session snapshot then compose host-specific arguments from the verified snapshot</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>InstructionsAssembler</ont:fromEntityId>
        <ont:toEntityId>Host</ont:toEntityId>
