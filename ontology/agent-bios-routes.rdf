    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/session_activation_3">
        <rdfs:label>session-activation.3</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Host"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>step 3 of session-activation: compose host-specific arguments from the verified snapshot then record activation intent and native source identity</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Host</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
