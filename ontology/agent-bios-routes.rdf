<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://agent-bios.local/ontology/agent-bios/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://agent-bios.local/ontology/agent-bios/">

    <owl:Ontology rdf:about="http://agent-bios.local/ontology/agent-bios/">
        <rdfs:label>agent-bios service routes</rdfs:label>
        <rdfs:comment>The six paths the service actually runs, in call order. Edges are SEQUENCE, not obligation, and the label carries the route and step number. Colour is ROUTE COUNT — pale slate on one route, purple on two, magenta on three or more; a darker node is a step where one change lands on several routes. Entities on no declared route are omitted; the obligation view carries them.</rdfs:comment>
    </owl:Ontology>

    <!-- Steps -->

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/CorpusRule">
        <rdfs:label>CorpusRule</rdfs:label>
        <rdfs:comment>An always-on instruction bullet in the global file, identified by its anchor substring. On 3 route(s): author-to-deployed, install, learn-loop; guard gated</rdfs:comment>
        <ont:icon>🔀</ont:icon>
        <ont:color>#E3008C</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Guide">
        <rdfs:label>Guide</rdfs:label>
        <rdfs:comment>A scoped instruction document loaded when a corpus rule's pointer fires. On 1 route(s): author-to-deployed; guard gated</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/PackagingTier">
        <rdfs:label>PackagingTier</rdfs:label>
        <rdfs:comment>core, domain, env-personal or infra — decides whether a unit is universal, opt-in, or plumbing. On 1 route(s): author-to-deployed; guard gated</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Domain">
        <rdfs:label>Domain</rdfs:label>
        <rdfs:comment>An opt-in bundle of instruction content; five exist today. On 1 route(s): author-to-deployed; guard gated</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/PayloadEntry">
        <rdfs:label>PayloadEntry</rdfs:label>
        <rdfs:comment>A shipped path; breakage is visible only on npm installs, which no checkout test sees. On 1 route(s): author-to-deployed; guard derived</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/HostPrerequisite">
        <rdfs:label>HostPrerequisite</rdfs:label>
        <rdfs:comment>A host tool the install requires rather than degrades without; git and python3&gt;=3.11 abort, zsh/codex/claude only warn. On 1 route(s): install; guard unguarded</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Migration">
        <rdfs:label>Migration</rdfs:label>
        <rdfs:comment>A one-way transform of previously deployed state; order-bearing. On 2 route(s): install, uninstall; guard unguarded</rdfs:comment>
        <ont:icon>🔀</ont:icon>
        <ont:color>#7719AA</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/CorpusAssembler">
        <rdfs:label>CorpusAssembler</rdfs:label>
        <rdfs:comment>Compiles catalog items into private immutable snapshots; the legacy assembler is retained for explicit migration regression checks. On 1 route(s): install; guard gated</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/DeployTarget">
        <rdfs:label>DeployTarget</rdfs:label>
        <rdfs:comment>A (source, destination, mode) triple; removal is derived, verification is hand-authored. On 1 route(s): install; guard partial</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Hook">
        <rdfs:label>Hook</rdfs:label>
        <rdfs:comment>Executable instruction that fires on a tool event, owned by manifest name not path marker. On 1 route(s): install; guard partial</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/LearningRecord">
        <rdfs:label>LearningRecord</rdfs:label>
        <rdfs:comment>The captured per-session artifact, minted by the collector. On 2 route(s): install, learn-loop; guard gated</rdfs:comment>
        <ont:icon>🔀</ont:icon>
        <ont:color>#7719AA</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/UserOwnedFileRegion">
        <rdfs:label>UserOwnedFileRegion</rdfs:label>
        <rdfs:comment>A marked span written into a file this repo does not own, never manifested. On 2 route(s): install, uninstall; guard partial</rdfs:comment>
        <ont:icon>🔀</ont:icon>
        <ont:color>#7719AA</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Wrapper">
        <rdfs:label>Wrapper</rdfs:label>
        <rdfs:comment>Internal dispatch script; codex-run is deployed and never byte-compared by verify. On 2 route(s): install, review-dispatch; guard unguarded</rdfs:comment>
        <ont:icon>🔀</ont:icon>
        <ont:color>#7719AA</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/PresetMode">
        <rdfs:label>PresetMode</rdfs:label>
        <rdfs:comment>software-engineer, builder or distill, plus the user-owned presets.local.toml. On 2 route(s): install, launch; guard gated</rdfs:comment>
        <ont:icon>🔀</ont:icon>
        <ont:color>#7719AA</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/TierBinding">
        <rdfs:label>TierBinding</rdfs:label>
        <rdfs:comment>(host, tier) to (model, effort); the parity gate hardcodes the very names it aligns. On 2 route(s): install, launch; guard partial</rdfs:comment>
        <ont:icon>🔀</ont:icon>
        <ont:color>#7719AA</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/ShellInterception">
        <rdfs:label>ShellInterception</rdfs:label>
        <rdfs:comment>The zero-argument launcher entry; an opt-in private shell connection owned by launch/shell_integration.py and a legacy compatibility adapter share launch/agent-launch.zsh. On 3 route(s): install, uninstall, launch; guard partial</rdfs:comment>
        <ont:icon>🔀</ont:icon>
        <ont:color>#E3008C</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Capability">
        <rdfs:label>Capability</rdfs:label>
        <rdfs:comment>An optional external tool; data-only, so no resolver branch reads its identity. On 2 route(s): install, review-dispatch; guard gated</rdfs:comment>
        <ont:icon>🔀</ont:icon>
        <ont:color>#7719AA</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/ManagedRuntime">
        <rdfs:label>ManagedRuntime</rdfs:label>
        <rdfs:comment>An interpreter environment this repo provisions, carrying a declared numbered-prompt fallback. On 1 route(s): install; guard partial</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/StateArtifact">
        <rdfs:label>StateArtifact</rdfs:label>
        <rdfs:comment>Persisted deployment state; each has a writer, readers and a migration. On 1 route(s): install; guard partial</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/DeploymentManifest">
        <rdfs:label>DeploymentManifest</rdfs:label>
        <rdfs:comment>The record of what this install wrote, and the sole authority for uninstall. On 2 route(s): install, uninstall; guard unguarded</rdfs:comment>
        <ont:icon>🔀</ont:icon>
        <ont:color>#7719AA</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Gate">
        <rdfs:label>Gate</rdfs:label>
        <rdfs:comment>An executable check owning an invariant, a subject set and an enforcement claim. On 1 route(s): install; guard gated</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/CliSubcommand">
        <rdfs:label>CliSubcommand</rdfs:label>
        <rdfs:comment>A user-invocable entry with three dispatch and advertisement sites, not one. On 1 route(s): learn-loop; guard unguarded</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/SessionDistillPipeline">
        <rdfs:label>SessionDistillPipeline</rdfs:label>
        <rdfs:comment>The heavy curator flow that mines many sessions into corpus-grade items. On 1 route(s): learn-loop; guard partial</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Host">
        <rdfs:label>Host</rdfs:label>
        <rdfs:comment>A model family seat; the provider reverse map must be unique to resolve one validatable seat. On 2 route(s): launch, review-dispatch; guard gated</rdfs:comment>
        <ont:icon>🔀</ont:icon>
        <ont:color>#7719AA</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Backend">
        <rdfs:label>Backend</rdfs:label>
        <rdfs:comment>The CLI actually executed, with its passthrough arguments. On 1 route(s): launch; guard gated</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/ReviewMethod">
        <rdfs:label>ReviewMethod</rdfs:label>
        <rdfs:comment>A named way to obtain a review, with perspectives, trials and a severity map. On 1 route(s): review-dispatch; guard gated</rdfs:comment>
        <ont:icon>▸</ont:icon>
        <ont:color>#A8B4C0</ont:color>
    </owl:Class>

    <!-- Route sequences -->

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/corpus-rule_entityId">
        <rdfs:label>entityId</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CorpusRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>corpus-rule</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/corpus-rule_routes">
        <rdfs:label>routes</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CorpusRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>author-to-deployed, install, learn-loop</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/corpus-rule_guard">
        <rdfs:label>guard</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CorpusRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>gated</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/corpus-rule_anchor">
        <rdfs:label>anchor</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CorpusRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>claude/CLAUDE.md</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/guide_entityId">
        <rdfs:label>entityId</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Guide"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>guide</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/guide_routes">
        <rdfs:label>routes</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Guide"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>author-to-deployed</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/guide_guard">
        <rdfs:label>guard</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Guide"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>gated</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/guide_anchor">
        <rdfs:label>anchor</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Guide"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>claude/guides/*.md guide_id frontmatter</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/packaging-tier_entityId">
        <rdfs:label>entityId</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/PackagingTier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>packaging-tier</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/packaging-tier_routes">
        <rdfs:label>routes</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/PackagingTier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>author-to-deployed</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/packaging-tier_guard">
        <rdfs:label>guard</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/PackagingTier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>gated</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/packaging-tier_anchor">
        <rdfs:label>anchor</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/PackagingTier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>compose/domains.json tiers</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/domain_entityId">
        <rdfs:label>entityId</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>domain</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/domain_routes">
        <rdfs:label>routes</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>author-to-deployed</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/domain_guard">
        <rdfs:label>guard</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>gated</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/domain_anchor">
        <rdfs:label>anchor</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>compose/domains.json domains</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/payload-entry_entityId">
        <rdfs:label>entityId</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/PayloadEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>payload-entry</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/payload-entry_routes">
        <rdfs:label>routes</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/PayloadEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>author-to-deployed</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/payload-entry_guard">
        <rdfs:label>guard</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/PayloadEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>derived</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/payload-entry_anchor">
        <rdfs:label>anchor</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/PayloadEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>package.json files[]</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/host-prerequisite_entityId">
        <rdfs:label>entityId</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/HostPrerequisite"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>host-prerequisite</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/host-prerequisite_routes">
        <rdfs:label>routes</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/HostPrerequisite"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>install</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/host-prerequisite_guard">
        <rdfs:label>guard</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/HostPrerequisite"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unguarded</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/host-prerequisite_anchor">
        <rdfs:label>anchor</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/HostPrerequisite"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>install.sh:67 check_prereqs</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

