        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Migration</ont:fromEntityId>
        <ont:toEntityId>UserOwnedFileRegion</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/legacy_uninstall_2">
