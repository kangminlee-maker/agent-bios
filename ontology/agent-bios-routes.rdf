        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/UserOwnedFileRegion"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/DeploymentManifest"/>
        <rdfs:comment>step 3 of shell-connection: preserve surrounding startup-file content then record script ownership and apply the planned writes</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>UserOwnedFileRegion</ont:fromEntityId>
        <ont:toEntityId>DeploymentManifest</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/setup_1">
        <rdfs:label>setup.1</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/ManagedRuntime"/>
        <rdfs:comment>step 1 of setup: select interactive install/onboard or explicit --non-interactive; reject a missing terminal before writes then verify and activate the shipped offline UI dependency bundle for interactive setup</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>CliSubcommand</ont:fromEntityId>
        <ont:toEntityId>ManagedRuntime</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/setup_2">
        <rdfs:label>setup.2</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/ManagedRuntime"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:comment>step 2 of setup: verify and activate the shipped offline UI dependency bundle for interactive setup then choose this run's installer UI language before dependency probes; revisiting preserves the plan</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>ManagedRuntime</ont:fromEntityId>
        <ont:toEntityId>CliSubcommand</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/setup_3">
        <rdfs:label>setup.3</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Selection"/>
        <rdfs:comment>step 3 of setup: choose this run's installer UI language before dependency probes; revisiting preserves the plan then review none, all or selected instructions targets in the shared setup plan</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>CliSubcommand</ont:fromEntityId>
        <ont:toEntityId>Selection</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/setup_4">
        <rdfs:label>setup.4</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Selection"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>step 4 of setup: review none, all or selected instructions targets in the shared setup plan then optionally select existing instruction sources without activating their contents</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Selection</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/setup_5">
        <rdfs:label>setup.5</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/HostPrerequisite"/>
        <rdfs:comment>step 5 of setup: optionally select existing instruction sources without activating their contents then inspect and select only required optional dependency actions</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>StateArtifact</ont:fromEntityId>
        <ont:toEntityId>HostPrerequisite</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/setup_6">
        <rdfs:label>setup.6</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/HostPrerequisite"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:comment>step 6 of setup: inspect and select only required optional dependency actions then preview and apply the accepted setup through its controller</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>HostPrerequisite</ont:fromEntityId>
        <ont:toEntityId>CliSubcommand</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/setup_7">
        <rdfs:label>setup.7</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>step 7 of setup: preview and apply the accepted setup through its controller then record the resulting private installation and separately requested extras</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>CliSubcommand</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/instruction_import_1">
        <rdfs:label>instruction-import.1</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>step 1 of instruction-import: discover fixed instruction filenames within selected roots then capture redacted text, original digest and scope without source writes</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>CliSubcommand</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/instruction_import_2">
        <rdfs:label>instruction-import.2</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsRule"/>
        <rdfs:comment>step 2 of instruction-import: capture redacted text, original digest and scope without source writes then review model-authored content and consumption placement</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>StateArtifact</ont:fromEntityId>
        <ont:toEntityId>InstructionsRule</ont:toEntityId>
