        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/ShellInterception"/>
        <rdfs:comment>step 2 of reset: journal the complete reset plan then remove only an existing owned shell connection</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>StateArtifact</ont:fromEntityId>
        <ont:toEntityId>ShellInterception</ont:toEntityId>
