        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Gate"/>
        <rdfs:comment>step 16 of legacy-install: append to the manifest then cmd_verify</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>DeploymentManifest</ont:fromEntityId>
