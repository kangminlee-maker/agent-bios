        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Migration"/>
        <rdfs:comment>step 1 of migrate: preview or explicitly apply migration then pin the release and capture bounded legacy inputs</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>CliSubcommand</ont:fromEntityId>
        <ont:toEntityId>Migration</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/migrate_2">
