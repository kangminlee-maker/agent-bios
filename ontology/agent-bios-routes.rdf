        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/DeploymentManifest"/>
        <rdfs:comment>step 15 of legacy-install: write the version marker then append to the manifest</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>StateArtifact</ont:fromEntityId>
        <ont:toEntityId>DeploymentManifest</ont:toEntityId>
