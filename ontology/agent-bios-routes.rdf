    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/shell_connection_1">
        <rdfs:label>shell-connection.1</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/ShellInterception"/>
        <rdfs:comment>step 1 of shell-connection: request status, restore or remove then derive a bounded shell plan from exact owned bytes</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>CliSubcommand</ont:fromEntityId>
        <ont:toEntityId>ShellInterception</ont:toEntityId>
