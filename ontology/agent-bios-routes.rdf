    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/shell_connection_2">
        <rdfs:label>shell-connection.2</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/ShellInterception"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/UserOwnedFileRegion"/>
        <rdfs:comment>step 2 of shell-connection: derive a bounded shell plan from exact owned bytes then preserve surrounding startup-file content</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>ShellInterception</ont:fromEntityId>
        <ont:toEntityId>UserOwnedFileRegion</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/shell_connection_3">
