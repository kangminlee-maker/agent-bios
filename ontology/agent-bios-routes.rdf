    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/reset_3">
        <rdfs:label>reset.3</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/ShellInterception"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>step 3 of reset: remove only an existing owned shell connection then reset private sources and generated understanding state</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>ShellInterception</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/reset_4">
        <rdfs:label>reset.4</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/DeployTarget"/>
        <rdfs:comment>step 4 of reset: reset private sources and generated understanding state then rebuild owned private installation projections</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>StateArtifact</ont:fromEntityId>
        <ont:toEntityId>DeployTarget</ont:toEntityId>
