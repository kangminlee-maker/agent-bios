        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/LearningRecord"/>
        <rdfs:comment>step 3 of migrate: remove only recognized owned native spans and files then import immutable learning events into private storage</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>UserOwnedFileRegion</ont:fromEntityId>
        <ont:toEntityId>LearningRecord</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/migrate_4">
        <rdfs:label>migrate.4</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/LearningRecord"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/DeployTarget"/>
        <rdfs:comment>step 4 of migrate: import immutable learning events into private storage then install the pinned private release and verify completion</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>LearningRecord</ont:fromEntityId>
        <ont:toEntityId>DeployTarget</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/reset_1">
