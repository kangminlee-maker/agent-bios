    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/instruction_import_3">
        <rdfs:label>instruction-import.3</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsRule"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Gate"/>
        <rdfs:comment>step 3 of instruction-import: review model-authored content and consumption placement then validate evidence coverage and unchanged source versions</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>InstructionsRule</ont:fromEntityId>
        <ont:toEntityId>Gate</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/instruction_import_4">
        <rdfs:label>instruction-import.4</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Gate"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>step 4 of instruction-import: validate evidence coverage and unchanged source versions then publish personal items and import receipt as one transaction</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Gate</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/instruction_import_5">
        <rdfs:label>instruction-import.5</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsAssembler"/>
        <rdfs:comment>step 5 of instruction-import: publish personal items and import receipt as one transaction then compile only items matching selected host/project scope</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>StateArtifact</ont:fromEntityId>
        <ont:toEntityId>InstructionsAssembler</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/app_context_1">
        <rdfs:label>app-context.1</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/DeployTarget"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/DeploymentManifest"/>
        <rdfs:comment>step 1 of app-context: optionally register the explicit-use bridge discovery entry then keep the registration verifiable and removable by ownership</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>DeployTarget</ont:fromEntityId>
        <ont:toEntityId>DeploymentManifest</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/app_context_2">
        <rdfs:label>app-context.2</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/DeploymentManifest"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Selection"/>
        <rdfs:comment>step 2 of app-context: keep the registration verifiable and removable by ownership then preview the requested task selection and ContentRef</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>DeploymentManifest</ont:fromEntityId>
        <ont:toEntityId>Selection</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/app_context_3">
        <rdfs:label>app-context.3</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Selection"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsAssembler"/>
        <rdfs:comment>step 3 of app-context: preview the requested task selection and ContentRef then return the selected immutable snapshot as task context</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Selection</ont:fromEntityId>
        <ont:toEntityId>InstructionsAssembler</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/app_context_4">
        <rdfs:label>app-context.4</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsAssembler"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>step 4 of app-context: return the selected immutable snapshot as task context then record returned-as-context separately from native pins</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>InstructionsAssembler</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/app_context_5">
        <rdfs:label>app-context.5</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:comment>step 5 of app-context: record returned-as-context separately from native pins then turn future use off without retracting delivered text</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>StateArtifact</ont:fromEntityId>
        <ont:toEntityId>CliSubcommand</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/conversation_setup_1">
        <rdfs:label>conversation_setup.1</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/HostPrerequisite"/>
        <rdfs:comment>step 1 of conversation_setup: read the exact package setup guide and choose a presentation language before dependency inspection then inspect local dependency readiness and available fixed installation recipes</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>CliSubcommand</ont:fromEntityId>
        <ont:toEntityId>HostPrerequisite</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/conversation_setup_2">
        <rdfs:label>conversation_setup.2</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/HostPrerequisite"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Selection"/>
        <rdfs:comment>step 2 of conversation_setup: inspect local dependency readiness and available fixed installation recipes then collect none, all or exact instructions choices without activating task context</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>HostPrerequisite</ont:fromEntityId>
        <ont:toEntityId>Selection</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/conversation_setup_3">
        <rdfs:label>conversation_setup.3</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Selection"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>step 3 of conversation_setup: collect none, all or exact instructions choices without activating task context then optionally discover explicitly scoped instruction sources for independent capture</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Selection</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/conversation_setup_5">
        <rdfs:label>conversation_setup.5</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:comment>step 5 of conversation_setup: issue a complete review bound to source, state, machine, roots, cwd and dependency executable identities then validate the exact review and explicit acknowledgment before applying selected effects</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>StateArtifact</ont:fromEntityId>
        <ont:toEntityId>CliSubcommand</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/conversation_setup_6">
        <rdfs:label>conversation_setup.6</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>step 6 of conversation_setup: validate the exact review and explicit acknowledgment before applying selected effects then persist operation outcomes so another call does not replay an existing attempt</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>CliSubcommand</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
