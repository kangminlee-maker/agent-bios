    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/session_activation_5">
        <rdfs:label>session-activation.5</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Backend"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>step 5 of session-activation: invoke the native host and bind its observed session identifier then resume with the recorded snapshot, arguments and native identity</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Backend</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/migrate_1">
