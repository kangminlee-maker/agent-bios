        <rdfs:label>install.8</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Wrapper"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/PresetMode"/>
        <rdfs:comment>step 8 of install: deploy the wrappers then migrate_user_presets</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Wrapper</ont:fromEntityId>
        <ont:toEntityId>PresetMode</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/install_9">
        <rdfs:label>install.9</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/PresetMode"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/TierBinding"/>
        <rdfs:comment>step 9 of install: migrate_user_presets then deploy profiles.toml</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>PresetMode</ont:fromEntityId>
        <ont:toEntityId>TierBinding</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/install_10">
        <rdfs:label>install.10</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/TierBinding"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/ShellInterception"/>
        <rdfs:comment>step 10 of install: deploy profiles.toml then deploy shell.zsh</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>TierBinding</ont:fromEntityId>
        <ont:toEntityId>ShellInterception</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/install_11">
        <rdfs:label>install.11</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/ShellInterception"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Capability"/>
        <rdfs:comment>step 11 of install: deploy shell.zsh then handle_capabilities</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>ShellInterception</ont:fromEntityId>
        <ont:toEntityId>Capability</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/install_12">
        <rdfs:label>install.12</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Capability"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/ManagedRuntime"/>
        <rdfs:comment>step 12 of install: handle_capabilities then provision-venv.sh</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Capability</ont:fromEntityId>
        <ont:toEntityId>ManagedRuntime</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/install_13">
        <rdfs:label>install.13</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/ManagedRuntime"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/ShellInterception"/>
        <rdfs:comment>step 13 of install: provision-venv.sh then add_zsh_hook</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>ManagedRuntime</ont:fromEntityId>
        <ont:toEntityId>ShellInterception</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/install_14">
        <rdfs:label>install.14</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/ShellInterception"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>step 14 of install: add_zsh_hook then write the version marker</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>ShellInterception</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/install_15">
        <rdfs:label>install.15</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/DeploymentManifest"/>
        <rdfs:comment>step 15 of install: write the version marker then append to the manifest</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>StateArtifact</ont:fromEntityId>
        <ont:toEntityId>DeploymentManifest</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/install_16">
        <rdfs:label>install.16</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/DeploymentManifest"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Gate"/>
        <rdfs:comment>step 16 of install: append to the manifest then cmd_verify</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>DeploymentManifest</ont:fromEntityId>
        <ont:toEntityId>Gate</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/install_17">
        <rdfs:label>install.17</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Gate"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/CorpusRule"/>
        <rdfs:comment>step 17 of install: cmd_verify then the agent session loads it</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Gate</ont:fromEntityId>
        <ont:toEntityId>CorpusRule</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/uninstall_1">
        <rdfs:label>uninstall.1</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Migration"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/UserOwnedFileRegion"/>
        <rdfs:comment>step 1 of uninstall: migrate_state then codex_config_additions remove</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Migration</ont:fromEntityId>
        <ont:toEntityId>UserOwnedFileRegion</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/uninstall_2">
        <rdfs:label>uninstall.2</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/UserOwnedFileRegion"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/DeploymentManifest"/>
        <rdfs:comment>step 2 of uninstall: codex_config_additions remove then replay the manifest</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>UserOwnedFileRegion</ont:fromEntityId>
        <ont:toEntityId>DeploymentManifest</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/uninstall_3">
        <rdfs:label>uninstall.3</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/DeploymentManifest"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/ShellInterception"/>
        <rdfs:comment>step 3 of uninstall: replay the manifest then remove_zsh_hook</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>DeploymentManifest</ont:fromEntityId>
        <ont:toEntityId>ShellInterception</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/learn_loop_1">
        <rdfs:label>learn-loop.1</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/LearningRecord"/>
        <rdfs:comment>step 1 of learn-loop: agent-bios learn then capture the record</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>CliSubcommand</ont:fromEntityId>
        <ont:toEntityId>LearningRecord</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/learn_loop_2">
        <rdfs:label>learn-loop.2</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/LearningRecord"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/SessionDistillPipeline"/>
        <rdfs:comment>step 2 of learn-loop: capture the record then curate and distill</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>LearningRecord</ont:fromEntityId>
        <ont:toEntityId>SessionDistillPipeline</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/learn_loop_3">
        <rdfs:label>learn-loop.3</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/SessionDistillPipeline"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/LearningRecord"/>
        <rdfs:comment>step 3 of learn-loop: curate and distill then the distilled item becomes a learning record</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>SessionDistillPipeline</ont:fromEntityId>
        <ont:toEntityId>LearningRecord</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/learn_loop_4">
        <rdfs:label>learn-loop.4</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/LearningRecord"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/CorpusRule"/>
        <rdfs:comment>step 4 of learn-loop: the distilled item becomes a learning record then promote into the corpus</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>LearningRecord</ont:fromEntityId>
        <ont:toEntityId>CorpusRule</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/launch_1">
        <rdfs:label>launch.1</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/ShellInterception"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/PresetMode"/>
        <rdfs:comment>step 1 of launch: zero-argument shell entry then pick a preset/mode</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>ShellInterception</ont:fromEntityId>
        <ont:toEntityId>PresetMode</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/launch_2">
        <rdfs:label>launch.2</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/PresetMode"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/TierBinding"/>
        <rdfs:comment>step 2 of launch: pick a preset/mode then resolve the tier binding</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>PresetMode</ont:fromEntityId>
        <ont:toEntityId>TierBinding</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/launch_3">
        <rdfs:label>launch.3</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/TierBinding"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Host"/>
        <rdfs:comment>step 3 of launch: resolve the tier binding then resolve the host seat</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>TierBinding</ont:fromEntityId>
        <ont:toEntityId>Host</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/launch_4">
        <rdfs:label>launch.4</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Host"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Backend"/>
        <rdfs:comment>step 4 of launch: resolve the host seat then run the backend CLI</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Host</ont:fromEntityId>
        <ont:toEntityId>Backend</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/review_dispatch_1">
        <rdfs:label>review-dispatch.1</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/ReviewMethod"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Capability"/>
        <rdfs:comment>step 1 of review-dispatch: select a review method then resolve its capability</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>ReviewMethod</ont:fromEntityId>
        <ont:toEntityId>Capability</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/review_dispatch_2">
        <rdfs:label>review-dispatch.2</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Capability"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Host"/>
        <rdfs:comment>step 2 of review-dispatch: resolve its capability then resolve the offered host</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Capability</ont:fromEntityId>
        <ont:toEntityId>Host</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/review_dispatch_3">
        <rdfs:label>review-dispatch.3</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Host"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Wrapper"/>
        <rdfs:comment>step 3 of review-dispatch: resolve the offered host then dispatch through the wrapper</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Host</ont:fromEntityId>
        <ont:toEntityId>Wrapper</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
