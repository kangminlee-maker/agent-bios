    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/manifest-determines-removal">
        <rdfs:label>determines_removal</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/DeploymentManifest"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:comment>Private install records, shell receipts and verified app bridge generations determine bounded removal; compatibility uninstall replays manifest.txt. Edge kind controls; enforcement unguarded</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>DeploymentManifest</ont:fromEntityId>
        <ont:toEntityId>CliSubcommand</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/prereq-gates-install">
        <rdfs:label>gates_entry</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/HostPrerequisite"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:comment>The selected entrypoint checks its runtime requirements before performing installation writes. Edge kind controls; enforcement unguarded</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>HostPrerequisite</ont:fromEntityId>
        <ont:toEntityId>CliSubcommand</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/subcommand-writes-learning">
        <rdfs:label>captures</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/LearningRecord"/>
        <rdfs:comment>the learn branch execs the collector with the caller's stdin on fd 3; it is the only PATH-reachable route to capture. Edge kind controls; enforcement unguarded</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>CliSubcommand</ont:fromEntityId>
        <ont:toEntityId>LearningRecord</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/migration-precedes-deploy">
        <rdfs:label>must_precede</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Migration"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/DeployTarget"/>
        <rdfs:comment>The explicit legacy install route runs migrate_user_presets before overwriting profiles.toml. Edge kind precedes; enforcement unguarded</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>Migration</ont:fromEntityId>
        <ont:toEntityId>DeployTarget</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/map-projects-lexicon">
        <rdfs:label>projects_to</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/DependencyMap"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/TerminologyAuthority"/>
        <rdfs:comment>LEXICON.md is emitted from the graph's lexicon block; emit-lexicon.py --check fails on a hand edit. Edge kind projects_to; enforcement derived</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>DependencyMap</ont:fromEntityId>
        <ont:toEntityId>TerminologyAuthority</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/gate-asserts-map">
        <rdfs:label>asserts</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Gate"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/DependencyMap"/>
        <rdfs:comment>check-ontology.py re-derives the map's facts from source and fails on disagreement. Edge kind asserts; enforcement gated</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Gate</ont:fromEntityId>
        <ont:toEntityId>DependencyMap</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/gate-asserts-terminology">
        <rdfs:label>asserts</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Gate"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/TerminologyAuthority"/>
        <rdfs:comment>check-lexicon.py forbids deprecated tokens and holds every concept home. Edge kind asserts; enforcement gated</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Gate</ont:fromEntityId>
        <ont:toEntityId>TerminologyAuthority</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/map-owes-lexicon-entry">
        <rdfs:label>registers_names_in</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/DependencyMap"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/TerminologyAuthority"/>
        <rdfs:comment>a new lasting name goes through LEXICON's concept homes — the rule AGENTS.md states and check-lexicon.py enforces. Edge kind owes_entry; enforcement gated</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>DependencyMap</ont:fromEntityId>
        <ont:toEntityId>TerminologyAuthority</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/assembler-writes-snapshot">
        <rdfs:label>materializes</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsAssembler"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>InstructionsStore.snapshot compiles and verifies immutable snapshot bytes and their content references; instructions session and integrity tests check the projection. Edge kind projects_to; enforcement gated</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>InstructionsAssembler</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/state-routes-host">
        <rdfs:label>pins</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Host"/>
        <rdfs:comment>Native launch/resume reads pinned snapshots and native identity; explicit app use returns a selected snapshot and records context delivery separately from native pins. Edge kind controls; enforcement partial</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>StateArtifact</ont:fromEntityId>
        <ont:toEntityId>Host</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/identity-controls-domain">
        <rdfs:label>qualifies</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/PackageIdentity"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Domain"/>
        <rdfs:comment>compose/pkgid.py defines package identity validation and the core fallback; changing those rules changes the qualified domain keys accepted by domain consumers. Edge kind controls; enforcement partial</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>PackageIdentity</ont:fromEntityId>
        <ont:toEntityId>Domain</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/imported-rule-requires-source">
        <rdfs:label>traces_to</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsRule"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:comment>Imported personal rules reference immutable captured evidence; import planning and apply validate source digests, line coverage and recorded host/project scope. Semantic correspondence remains a model/user review. Edge kind requires; enforcement gated</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>InstructionsRule</ont:fromEntityId>
        <ont:toEntityId>StateArtifact</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/gate-asserts-ui-runtime">
        <rdfs:label>asserts</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Gate"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/ManagedRuntime"/>
        <rdfs:comment>gates/build-ui-runtime.py check/self-test compares the bundle against TEXTUAL_PIN, exact wheel metadata/hashes/licenses, and isolated offline import/render/cleanup controls. Edge kind asserts; enforcement gated</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>Gate</ont:fromEntityId>
        <ont:toEntityId>ManagedRuntime</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/setup-review-controls-apply">
        <rdfs:label>constrains_apply</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/StateArtifact"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/CliSubcommand"/>
        <rdfs:comment>SetupService.apply re-derives the exact reviewed context, source/state and dependency executable identities before effects; test_instructions_setup_cli checks mismatch refusal and receipt-based non-replay. Review identifiers establish consistency, not human consent. Edge kind controls; enforcement gated</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>StateArtifact</ont:fromEntityId>
        <ont:toEntityId>CliSubcommand</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
