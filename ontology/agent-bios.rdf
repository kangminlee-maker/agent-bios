    <!-- Object properties: the obligation edges -->

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/rule-points-to-guide">
        <rdfs:label>points_to</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsRule"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Guide"/>
        <rdfs:comment>The private compiler emits router links for selected relevant guides; legacy global pointers remain only on the retained deployment route. Edge kind requires; enforcement gated</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>InstructionsRule</ont:fromEntityId>
        <ont:toEntityId>Guide</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/hook-enforces-guide">
        <rdfs:label>enforces</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Hook"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Guide"/>
        <rdfs:comment>domains.json hooks[].source_guide binds a hook to the guide it enforces. Edge kind requires; enforcement gated</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>Hook</ont:fromEntityId>
        <ont:toEntityId>Guide</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/tier-classifies-rule">
        <rdfs:label>tiered_in</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsRule"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/PackagingTier"/>
        <rdfs:comment>An untiered unit lets the assembler's default decide distribution. Edge kind owes_entry; enforcement gated</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>InstructionsRule</ont:fromEntityId>
        <ont:toEntityId>PackagingTier</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/domain-groups-guide">
        <rdfs:label>classified_in</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Guide"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/Domain"/>
        <rdfs:comment>Every instruction unit carries a domains[] membership. Edge kind owes_entry; enforcement gated</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>Guide</ont:fromEntityId>
        <ont:toEntityId>Domain</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/package-scopes-domain">
        <rdfs:label>scoped_under</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Domain"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/PackageIdentity"/>
        <rdfs:comment>Domains are package-local, so (package_id, domain) is the key. Edge kind owes_entry; enforcement gated</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>Domain</ont:fromEntityId>
        <ont:toEntityId>PackageIdentity</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/selection-routes-assembler">
        <rdfs:label>routes</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Selection"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsAssembler"/>
        <rdfs:comment>Selection mode and qualified targets determine snapshot items; none produces no instructions or bootstrap, and imported host/project scope constrains every selection. Edge kind controls; enforcement unguarded</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Selection</ont:fromEntityId>
        <ont:toEntityId>InstructionsAssembler</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/assembler-composes-rule">
        <rdfs:label>composes</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsAssembler"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/InstructionsRule"/>
