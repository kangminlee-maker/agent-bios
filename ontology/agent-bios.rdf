<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://agent-bios.local/ontology/agent-bios/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://agent-bios.local/ontology/agent-bios/">

    <owl:Ontology rdf:about="http://agent-bios.local/ontology/agent-bios/">
        <rdfs:label>agent-bios</rdfs:label>
        <rdfs:comment>Change one concept — how far do the obligations reach, and which of them is anything actually holding? Colour is guard status: red is unguarded.</rdfs:comment>
    </owl:Ontology>

    <!-- Entity types -->

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/CorpusRule">
        <rdfs:label>CorpusRule</rdfs:label>
        <rdfs:comment>An always-on instruction bullet in the global file, identified by its anchor substring. Family F1 Instruction content; reaches P1/P2/P3/P4/P5/P6; guard gated</rdfs:comment>
        <ont:icon>📘</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Guide">
        <rdfs:label>Guide</rdfs:label>
        <rdfs:comment>A scoped instruction document loaded when a corpus rule's pointer fires. Family F1 Instruction content; reaches P1/P2/P3/P4/P5/P6; guard gated</rdfs:comment>
        <ont:icon>📘</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/AgentTemplate">
        <rdfs:label>AgentTemplate</rdfs:label>
        <rdfs:comment>A subagent role definition; reviewer.toml exists on Codex with no Claude counterpart. Family F1 Instruction content; reaches P1/P3/P4/P5/P6; guard partial</rdfs:comment>
        <ont:icon>📘</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Hook">
        <rdfs:label>Hook</rdfs:label>
        <rdfs:comment>Executable instruction that fires on a tool event, owned by manifest name not path marker. Family F1 Instruction content; reaches P1/P3/P4/P5/P6; guard partial</rdfs:comment>
        <ont:icon>📘</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/LearningRecord">
        <rdfs:label>LearningRecord</rdfs:label>
        <rdfs:comment>The captured per-session artifact, minted by the collector. Family F1 Instruction content; reaches P1/P4/P5/P6; guard gated</rdfs:comment>
        <ont:icon>📘</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/SessionDistillPipeline">
        <rdfs:label>SessionDistillPipeline</rdfs:label>
        <rdfs:comment>The heavy curator flow that mines many sessions into corpus-grade items. Family F1 Instruction content; reaches P1/P5/P6; guard partial</rdfs:comment>
        <ont:icon>📘</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/PackagingTier">
        <rdfs:label>PackagingTier</rdfs:label>
        <rdfs:comment>core, domain, env-personal or infra — decides whether a unit is universal, opt-in, or plumbing. Family F2 Classification &amp; packaging; reaches P1/P5/P6; guard gated</rdfs:comment>
        <ont:icon>📦</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Domain">
        <rdfs:label>Domain</rdfs:label>
        <rdfs:comment>An opt-in bundle of instruction content; five exist today. Family F2 Classification &amp; packaging; reaches P1/P5/P6; guard gated</rdfs:comment>
        <ont:icon>📦</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/PackageIdentity">
        <rdfs:label>PackageIdentity</rdfs:label>
        <rdfs:comment>Unversioned by design; the pair (package_id, domain) is the real key. Family F2 Classification &amp; packaging; reaches P1/P5/P6; guard gated</rdfs:comment>
        <ont:icon>📦</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Selection">
        <rdfs:label>Selection</rdfs:label>
        <rdfs:comment>Qualified package/domain choices seed private snapshots; a one-off launch can choose without rewriting the saved selection. Family F2 Classification &amp; packaging; reaches P4/P5; guard unguarded</rdfs:comment>
        <ont:icon>📦</ont:icon>
        <ont:color>#D13438</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/PresetMode">
        <rdfs:label>PresetMode</rdfs:label>
        <rdfs:comment>software-engineer, builder or distill, plus the user-owned presets.local.toml. Family F2 Classification &amp; packaging; reaches P1/P4/P5/P6; guard gated</rdfs:comment>
        <ont:icon>📦</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Backend">
        <rdfs:label>Backend</rdfs:label>
        <rdfs:comment>The CLI actually executed, with its passthrough arguments. Family F3 Capability binding; reaches P1/P4/P5/P6; guard gated</rdfs:comment>
        <ont:icon>🔌</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Host">
        <rdfs:label>Host</rdfs:label>
        <rdfs:comment>A model family seat; the provider reverse map must be unique to resolve one validatable seat. Family F3 Capability binding; reaches P1/P4/P5/P6; guard gated</rdfs:comment>
        <ont:icon>🔌</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/TierBinding">
        <rdfs:label>TierBinding</rdfs:label>
        <rdfs:comment>(host, tier) to (model, effort); the parity gate hardcodes the very names it aligns. Family F3 Capability binding; reaches P1/P4/P5/P6; guard partial</rdfs:comment>
        <ont:icon>🔌</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Capability">
        <rdfs:label>Capability</rdfs:label>
        <rdfs:comment>An optional external tool; data-only, so no resolver branch reads its identity. Family F3 Capability binding; reaches P1/P4/P5/P6; guard gated</rdfs:comment>
        <ont:icon>🔌</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/ReviewMethod">
        <rdfs:label>ReviewMethod</rdfs:label>
        <rdfs:comment>A named way to obtain a review, with perspectives, trials and a severity map. Family F3 Capability binding; reaches P1/P4/P5/P6; guard gated</rdfs:comment>
        <ont:icon>🔌</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Wrapper">
        <rdfs:label>Wrapper</rdfs:label>
        <rdfs:comment>Internal dispatch script; codex-run is deployed and never byte-compared by verify. Family F3 Capability binding; reaches P1/P3/P4/P5; guard unguarded</rdfs:comment>
        <ont:icon>🔌</ont:icon>
        <ont:color>#D13438</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/ManagedRuntime">
        <rdfs:label>ManagedRuntime</rdfs:label>
        <rdfs:comment>An interpreter environment this repo provisions, carrying a declared numbered-prompt fallback. Family F3 Capability binding; reaches P1/P3/P4/P5/P6; guard partial</rdfs:comment>
        <ont:icon>🔌</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/CliSubcommand">
        <rdfs:label>CliSubcommand</rdfs:label>
        <rdfs:comment>A user-invocable entry with three dispatch and advertisement sites, not one. Family F4 Distribution mechanism; reaches P1/P3/P4/P5; guard unguarded</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#D13438</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/DeployTarget">
        <rdfs:label>DeployTarget</rdfs:label>
        <rdfs:comment>A (source, destination, mode) triple; removal is derived, verification is hand-authored. Family F4 Distribution mechanism; reaches P1/P4/P6; guard partial</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/PayloadEntry">
        <rdfs:label>PayloadEntry</rdfs:label>
        <rdfs:comment>A shipped path; breakage is visible only on npm installs, which no checkout test sees. Family F4 Distribution mechanism; reaches P1/P3/P6; guard derived</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/DeploymentManifest">
        <rdfs:label>DeploymentManifest</rdfs:label>
        <rdfs:comment>The record of what this install wrote, and the sole authority for uninstall. Family F4 Distribution mechanism; reaches P4/P5; guard unguarded</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#D13438</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/StateArtifact">
        <rdfs:label>StateArtifact</rdfs:label>
        <rdfs:comment>Persisted deployment state; each has a writer, readers and a migration. Family F4 Distribution mechanism; reaches P4/P5/P6; guard partial</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Migration">
        <rdfs:label>Migration</rdfs:label>
        <rdfs:comment>A one-way transform of previously deployed state; order-bearing. Family F4 Distribution mechanism; reaches P1/P5; guard unguarded</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#D13438</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/SchemaVersion">
        <rdfs:label>SchemaVersion</rdfs:label>
        <rdfs:comment>The declared format contract of a persisted artifact, and migration's trigger. Family F4 Distribution mechanism; reaches P1/P5; guard unguarded</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#D13438</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/UserOwnedFileRegion">
        <rdfs:label>UserOwnedFileRegion</rdfs:label>
        <rdfs:comment>A marked span written into a file this repo does not own, never manifested. Family F4 Distribution mechanism; reaches P1/P4/P5/P6; guard partial</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/ShellInterception">
        <rdfs:label>ShellInterception</rdfs:label>
        <rdfs:comment>The zero-argument launcher entry; an opt-in private shell connection owned by launch/shell_integration.py and a legacy compatibility adapter share launch/agent-launch.zsh. Family F4 Distribution mechanism; reaches P1/P4/P5/P6; guard partial</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/EnvironmentVariable">
        <rdfs:label>EnvironmentVariable</rdfs:label>
        <rdfs:comment>A runtime override that moves where this repo reads or writes. Family F4 Distribution mechanism; reaches P5; guard unguarded</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#D13438</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/CorpusAssembler">
        <rdfs:label>CorpusAssembler</rdfs:label>
        <rdfs:comment>Compiles catalog items into private immutable snapshots; the legacy assembler is retained for explicit migration regression checks. Family F4 Distribution mechanism; reaches P1/P3/P5/P6; guard gated</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Gate">
        <rdfs:label>Gate</rdfs:label>
        <rdfs:comment>An executable check owning an invariant, a subject set and an enforcement claim. Family F5 Assurance; reaches P1/P5/P6; guard gated</rdfs:comment>
        <ont:icon>🛡️</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/Golden">
        <rdfs:label>Golden</rdfs:label>
        <rdfs:comment>Captured expected behaviour; payload with a regeneration rule. Family F5 Assurance; reaches P1/P2/P5/P6; guard derived</rdfs:comment>
        <ont:icon>🛡️</ont:icon>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/NegativeControl">
        <rdfs:label>NegativeControl</rdfs:label>
        <rdfs:comment>A case asserting the gate fails when it should; without one a gate is unproven. Family F5 Assurance; reaches P1/P5; guard unguarded</rdfs:comment>
        <ont:icon>🛡️</ont:icon>
        <ont:color>#D13438</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/SelfTest">
        <rdfs:label>SelfTest</rdfs:label>
        <rdfs:comment>Seven entry points, each run by check-parity.sh. Family F5 Assurance; reaches P1/P5/P6; guard gated</rdfs:comment>
        <ont:icon>🛡️</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/ActivationCanary">
        <rdfs:label>ActivationCanary</rdfs:label>
        <rdfs:comment>Separates bytes being on disk from the agent actually reading them. Family F5 Assurance; reaches P1/P5; guard unguarded</rdfs:comment>
        <ont:icon>🛡️</ont:icon>
        <ont:color>#D13438</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/MeasurementInstrument">
        <rdfs:label>MeasurementInstrument</rdfs:label>
        <rdfs:comment>Produces the numbers each guide's Evidence Base cites; the single owner of measurement. Family F5 Assurance; reaches P1/P5; guard unguarded</rdfs:comment>
        <ont:icon>🛡️</ont:icon>
        <ont:color>#D13438</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/HostPrerequisite">
        <rdfs:label>HostPrerequisite</rdfs:label>
        <rdfs:comment>A host tool the install requires rather than degrades without; git and python3&gt;=3.11 abort, zsh/codex/claude only warn. Family F3 Capability binding; reaches P1/P5; guard unguarded</rdfs:comment>
        <ont:icon>🔌</ont:icon>
        <ont:color>#D13438</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/TerminologyAuthority">
        <rdfs:label>TerminologyAuthority</rdfs:label>
        <rdfs:comment>The naming contract — canonical terms, concept homes, deprecated aliases; LEXICON.md is its projection and check-lexicon.py enforces it. Family F5 Assurance; reaches P2/P5/P6; guard gated</rdfs:comment>
        <ont:icon>🛡️</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://agent-bios.local/ontology/agent-bios/DependencyMap">
        <rdfs:label>DependencyMap</rdfs:label>
        <rdfs:comment>This ontology itself — entities, obligations and routes; canonical in graph.json and held against real source by check-ontology.py. Family F5 Assurance; reaches P1/P5/P6; guard gated</rdfs:comment>
        <ont:icon>🛡️</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <!-- Data properties: the ontology's own facts, one shape for every entity -->

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/corpus-rule_entityId">
        <rdfs:label>entityId</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CorpusRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>corpus-rule</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/corpus-rule_family">
        <rdfs:label>family</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CorpusRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>F1 Instruction content</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/corpus-rule_reaches">
        <rdfs:label>reaches</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CorpusRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>P1/P2/P3/P4/P5/P6</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/corpus-rule_guard">
        <rdfs:label>guard</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CorpusRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>gated</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/corpus-rule_anchor">
        <rdfs:label>anchor</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/CorpusRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>claude/CLAUDE.md</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/guide_entityId">
        <rdfs:label>entityId</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Guide"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>guide</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/guide_family">
        <rdfs:label>family</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Guide"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>F1 Instruction content</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/guide_reaches">
        <rdfs:label>reaches</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Guide"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>P1/P2/P3/P4/P5/P6</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/guide_guard">
        <rdfs:label>guard</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Guide"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>gated</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/guide_anchor">
        <rdfs:label>anchor</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Guide"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>claude/guides/*.md guide_id frontmatter</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/agent-template_entityId">
        <rdfs:label>entityId</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/AgentTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>agent-template</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/agent-template_family">
        <rdfs:label>family</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/AgentTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>F1 Instruction content</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://agent-bios.local/ontology/agent-bios/agent-template_reaches">
        <rdfs:label>reaches</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/AgentTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>P1/P3/P4/P5/P6</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

