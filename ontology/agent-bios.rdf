        <ont:toEntityId>DeployTarget</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/map-projects-lexicon">
        <rdfs:label>projects_to</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/DependencyMap"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/TerminologyAuthority"/>
        <rdfs:comment>LEXICON.md is emitted from the graph's lexicon block; emit-lexicon.py --check fails on a hand edit. Edge kind projects_to; enforcement derived</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>DependencyMap</ont:fromEntityId>
        <ont:toEntityId>TerminologyAuthority</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/gate-asserts-map">
        <rdfs:label>asserts</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Gate"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/DependencyMap"/>
        <rdfs:comment>check-ontology.py re-derives the map's facts from source and fails on disagreement. Edge kind asserts; enforcement gated</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Gate</ont:fromEntityId>
        <ont:toEntityId>DependencyMap</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/gate-asserts-terminology">
        <rdfs:label>asserts</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/Gate"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/TerminologyAuthority"/>
        <rdfs:comment>check-lexicon.py forbids deprecated tokens and holds every concept home. Edge kind asserts; enforcement gated</rdfs:comment>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:fromEntityId>Gate</ont:fromEntityId>
        <ont:toEntityId>TerminologyAuthority</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://agent-bios.local/ontology/agent-bios/map-owes-lexicon-entry">
        <rdfs:label>registers_names_in</rdfs:label>
        <rdfs:domain rdf:resource="http://agent-bios.local/ontology/agent-bios/DependencyMap"/>
        <rdfs:range rdf:resource="http://agent-bios.local/ontology/agent-bios/TerminologyAuthority"/>
        <rdfs:comment>a new lasting name goes through LEXICON's concept homes — the rule AGENTS.md states and check-lexicon.py enforces. Edge kind owes_entry; enforcement gated</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>DependencyMap</ont:fromEntityId>
        <ont:toEntityId>TerminologyAuthority</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
