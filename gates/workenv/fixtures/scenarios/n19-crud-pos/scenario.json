 ],
 "says": "One person founds a Team alone (team.found, self-founded mode that says it reviewed itself, finalized on their laptop): the owner commits the Team's policy, the founder's grant, an active team_state and a team_profile named Platform, and moves the Team's head. A team.state.read at that head returns exactly those records. The founder then renames the Team to Platform standards (team.profile.set on the head the founding moved to): the stored profile keeps the same team_id and only the name and its updated_at change; a read at the new head shows the new profile beside the unchanged state, policy and grant. The founder then closes the Team (team.lifecycle.apply close, whose plan names the founder as surviving owner, lists the laptop as the one holder it reached, holds no outbox entry or custody, keeps no repository and requests no purge): the owner returns a closed team_state under a third receipt, and a last read shows the closed state and the renamed profile. Each read names the head of the step it follows, so every change is seen under its own receipt; no read writes anything, and no step changes the team_id.",
 "spec_sha256": "1c96bddab4a83c9400bec5fac264358d98afb4ffc9972eee4a2b02ec04df0237",
 "steps": [
  {
   "carries": [
    "proposal",
    "proposed_policy"
   ],
   "head": "founded",
   "name": "found",
   "request": "found_request",
   "result": "found_result",
   "returns": [
    "team_policy",
    "founder_grant",
    "active_state",
    "first_profile"
   ],
   "submits": [
    "proposed_policy"
   ]
  },
  {
   "carries": [],
   "name": "read_founded",
   "request": "read_after_found",
   "result": "read_founded_result",
   "returns": [
    "active_state",
    "first_profile",
    "team_policy",
    "founder_grant"
   ]
  },
  {
   "carries": [
    "new_name"
   ],
   "head": "renamed",
   "name": "rename",
   "request": "rename_request",
   "result": "rename_result",
   "returns": [
    "renamed_profile"
   ]
  },
  {
   "carries": [],
   "name": "read_renamed",
   "request": "read_after_rename",
   "result": "read_renamed_result",
   "returns": [
    "active_state",
    "renamed_profile",
    "team_policy",
    "founder_grant"
   ]
  },
  {
   "carries": [
    "closure"
   ],
   "head": "closed",
   "name": "close",
   "request": "close_request",
   "result": "close_result",
   "returns": [
    "closed_state"
   ]
  },
  {
   "carries": [],
   "name": "read_closed",
   "request": "read_after_close",
   "result": "read_closed_result",
   "returns": [
    "closed_state",
    "renamed_profile",
    "team_policy",
    "founder_grant"
   ]
  }
 ]
