 ],
 "says": "Alice has bound her device key and registered a private notes source, then locks the profile (generation 2). She tries to unlock while her key's private half sits beside the public key the signing call names: the unlock is refused with private_key_beside_public and the profile stays locked, because under that layout OpenSSH would prompt for the passphrase again outside the unlock. She tries again while SSH_AUTH_SOCK names a signing agent this runtime does not own: refused with agent_not_owned_here. While locked, the signed commit of her notes' first revision is not admitted, with access_locked: no signature is made. With the public half stored apart and the runtime's own agent, an unlock at a terminal succeeds (generation 2), and the same commit is admitted. What must not happen: a signature made while locked, an unlock through an agent the runtime does not own, or any passphrase prompt other than the one inside the unlock transition.",
 "spec_sha256": "f92e73709aec7b4501cc01bf94f043d7ba141ebf35144ee457ebfdcbd25a28d3",
 "steps": [
  {
   "carries": [
    "alice_laptop_key"
   ],
   "name": "bind_key",
   "request": "bind_alice_laptop",
   "result": "bind_key_result",
   "returns": [
    "alice_laptop_binding"
   ]
  },
  {
   "carries": [
    "notes_home"
   ],
   "name": "register_notes",
   "request": "register_request",
   "result": "register_notes_result",
   "returns": [
    "stored_home"
   ]
  },
  {
   "carries": [
    "lock_change"
   ],
   "name": "lock",
   "request": "lock_request",
   "result": "lock_result",
   "returns": [
    "lock_state"
   ]
  },
  {
   "carries": [
    "unlock_with_private_key_beside_change"
   ],
   "name": "unlock_with_private_key_beside",
   "request": "unlock_with_private_key_beside_request",
   "result": "unlock_with_private_key_beside_result",
   "returns": []
  },
