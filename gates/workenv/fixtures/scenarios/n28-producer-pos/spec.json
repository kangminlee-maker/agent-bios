   "name": "span_member",
   "text": "{\"record\":12,\"role\":\"user\",\"text\":\"Which journal mode does the local state database use?\"}\n{\"record\":13,\"role\":\"assistant\",\"text\":\"WAL, with synchronous FULL. Effective from 2026-01-01 under jurisdiction KR. Reason: 4.11 ms per commit against 11.76, and readers are not blocked.\"}\n{\"record\":14,\"role\":\"user\",\"text\":\"Where are the local state backups written?\"}\n{\"record\":15,\"role\":\"assistant\",\"text\":\"To a second local SSD, not to the network volume. Effective from 2026-03-01 for storage: a local SSD.\"}\n{\"record\":16,\"role\":\"user\",\"text\":\"Keep an eye on the network volume in case that changes.\"}\n{\"record\":17,\"role\":\"assistant\",\"text\":\"Noted; will revisit if the volume changes.\"}\n{\"record\":18,\"role\":\"assistant\",\"text\":\"Filed both decisions with the measured numbers attached.\"}\n"
  }
