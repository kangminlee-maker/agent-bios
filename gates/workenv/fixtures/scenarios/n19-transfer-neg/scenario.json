 ],
 "says": "A person founds a Team alone on their laptop, so they are its only owner, recovery holder and finalizer, and keeps one draft purpose on the laptop as a candidate. A handover of the owner duty that names no recipient has no spelling and is refused at admission. Leaving the Team (team.membership.leave), even with the draft settled, would take away the last holder of every required duty with nobody to receive them, and the owner refuses it with last_owner_removal_refused. Retiring the laptop from the Team (team.device.retire, on the Team at its current head) with a disposition that lists no item, while the laptop holds the draft and nowhere else does, is refused with unique_outbox_at_risk; a retirement that omits its disposition altogether is refused at admission. None of the refused steps returns a record or moves the head: a last team.state.read at the head the founding moved to returns the same active state, profile, policy, membership and grant as before.",
 "spec_sha256": "9952c489303e4e3e481b540b8a40dd4d0598065349db574871e5647bdb250494",
 "steps": [
  {
   "carries": [
    "proposal",
    "proposed_policy"
   ],
   "head": "founded",
   "name": "found",
   "request": "found_request",
   "result": "found_result",
   "returns": [
    "team_sealed_proposal",
    "team_policy",
    "team_founder_membership",
    "founder_grant",
    "active_state",
    "first_profile",
    "team_founding_epoch"
   ],
   "submits": [
    "proposed_policy"
   ]
  },
  {
   "carries": [
    "draft_purpose"
   ],
   "name": "keep_draft",
   "request": "draft_request",
   "result": "keep_draft_result",
   "returns": [
    "draft_profile"
   ]
  },
  {
   "carries": [
    "handover_to_nobody"
   ],
   "name": "hand_owner_to_nobody",
   "refused": [
    {
     "code": "missing_field",
     "pointer": "/to_principal_id",
     "record": "handover_to_nobody"
    }
   ],
   "request": "handover_request"
  },
  {
   "carries": [
