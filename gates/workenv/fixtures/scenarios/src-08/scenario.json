 ],
 "says": "A person starts material in a domain none of their sources covers, clinical trial protocols. They register a new managed knowledge source in their personal scope whose applicability states that domain and whose acceptance authority is themselves (source.home.register), commit its first revision, select records 12 to 18 of one session transcript (source.observe, nothing written) and capture one knowledge member from exactly those bytes into the new source (source.capture.record): the owner stores a draft capture naming the observation, the span evidence and the personal destination it permits, with the extraction run that made it, and commits nothing. The same capture resubmitted as Instructions is refused at admission (the knowledge capture's role cannot be instructions), so a new category of knowledge cannot become behavioural text or add an Instructions domain. With a Team the person founded and its own Team knowledge source registered, the same capture aimed at the Team source without stating a widening and its authority is refused with widening_unstated: new-domain material never lands in, or is adopted as, Team content by default, and the Team source stays at its registration head.",
 "spec_sha256": "477f023864397aab2ad093c4fe2f6fd4d16587410595f6f859df5d5238346daf",
 "steps": [
  {
   "carries": [
    "trials_home"
   ],
   "head": "trials_registered",
   "name": "register_new_domain_source",
   "request": "register_trials",
   "result": "register_new_domain_source_result",
   "returns": [
    "stored_trials_home"
   ]
  },
  {
   "carries": [
    "trials_rev1"
   ],
   "head": "trials_rev1_head",
   "name": "commit_first_revision",
   "request": "commit_trials",
   "result": "commit_first_revision_result",
   "returns": [
    "stored_trials_rev1"
   ]
  },
  {
   "carries": [
    "selection"
   ],
   "name": "observe_span",
   "request": "observe",
   "result": "observe_span_result",
   "returns": [
    "observation"
   ]
  },
  {
   "carries": [
    "capture"
   ],
   "name": "capture_candidate",
   "request": "capture_submit",
   "result": "capture_candidate_result",
   "returns": [
    "stored_capture",
    "run"
   ]
  },
  {
   "carries": [
    "capture_as_instructions"
   ],
   "name": "refuse_capture_as_instructions",
   "refused": [
    {
     "code": "value_not_allowed",
     "pointer": "/role",
     "record": "capture_as_instructions"
    }
   ],
   "request": "capture_as_instructions_submit"
