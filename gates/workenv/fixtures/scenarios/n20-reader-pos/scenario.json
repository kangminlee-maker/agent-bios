 ],
 "says": "A repository knowledge source with a rate table and its prose is registered, and its first revision is committed on the head the registration moved to. The editor loads the bodies it will edit with reader.body.read in the knowledge role and the contributor view; the result delivers both units with their bodies and names the source's frontier, the head the commit moved to. The author corrects the table and the editor saves it with source.revision.commit whose base expects exactly that frontier as the head, and the owner commits the second revision on it. The saved revision's base is the frontier the read returned, not a head the editor assumed.",
 "spec_sha256": "8c43bad8946172156e2423815b748db80329805fdf62a9a864aa44dd28f05f03",
 "steps": [
  {
   "carries": [
    "rates_home"
   ],
   "head": "rates_registered",
   "name": "register_rates_home",
   "request": "register_rates",
   "result": "register_rates_home_result",
   "returns": [
