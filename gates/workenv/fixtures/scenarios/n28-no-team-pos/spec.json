  {"name": "capture_span", "request": "capture_submit", "carries": ["capture"],
   "answer": {"stage": "draft", "local_effect": "candidate_stored",
              "provider_effect": "not_applicable", "gaps": [], "recovery": [],
              "returns": ["stored_capture", "run"]}},
  {"name": "store_candidate", "request": "candidate_submit", "carries": ["candidate"],
   "answer": {"stage": "draft", "local_effect": "candidate_stored",
              "provider_effect": "not_applicable", "gaps": [], "recovery": [],
              "returns": ["stored_candidate"]}}
 ]
