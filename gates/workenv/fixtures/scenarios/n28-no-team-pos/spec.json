{
 "case": "N28-NO-TEAM-POS",
 "says": "A person on a local profile with no Team, no provider connection and no carrier binding selects records 12 to 18 of one Claude Code session transcript and asks for its memory to be captured into one named repository source. The owner reads exactly that span (source.observe, nothing written), the packaged local adapter extracts one memory entry from those bytes (source.capture.record, a draft capture and the extraction run that produced it), and the person stores a candidate choice extracted from that capture (memory.candidate.store). Every answer comes back with provider_effect not_applicable, the capture and the candidate both name the destination source the person requested, and the candidate names the capture and the exact span bytes it rests on. No step signs in, reaches a provider or a carrier, or calls any Team operation, and nothing here is committed to a destination.",
 "ids": [
  {"name": "me", "prefix": "prn"},
  {"name": "laptop", "prefix": "dev"},
  {"name": "local_profile", "prefix": "prf"},
  {"name": "repo", "prefix": "rep"},
  {"name": "decisions", "prefix": "src"},
  {"name": "lane", "prefix": "wst"},
  {"name": "measured_source", "prefix": "src"},
  {"name": "entry", "prefix": "ent"},
  {"name": "observe_request", "prefix": "req"},
  {"name": "capture_request", "prefix": "req"},
  {"name": "candidate_request", "prefix": "req"}
 ],
 "records": [
  {"name": "selection", "from": "c01/selection_of_a_transcript_span.json"},
  {"name": "observe", "from": "c01/observe_request.json",
   "set": [
    {"pointer": "/request_id", "value": "@observe_request"},
    {"pointer": "/actor/principal_id", "value": "@me"},
    {"pointer": "/actor/device_id", "value": "@laptop"},
    {"pointer": "/actor/profile_id", "value": "@local_profile"},
    {"pointer": "/owner/repository_id", "value": "@repo"},
    {"pointer": "/target/resource_id", "value": "@repo"},
    {"pointer": "/payload_digest", "value": "#selection"}]},
  {"name": "observation", "from": "c01/observation_of_a_selected_transcript_span.json",
   "set": [
    {"pointer": "/selection_digest", "value": "#selection"},
    {"pointer": "/read/0/digest", "value": "$digest:span_bytes"},
    {"pointer": "/observed_at", "value": "$instant:observed_at"}]},
  {"name": "capture", "from": "sources/capture_of_memory_material_submitted.json",
   "set": [
    {"pointer": "/destination_source_id", "value": "@decisions"},
    {"pointer": "/observation_digest", "value": "#observation"},
    {"pointer": "/entries/0/entry_id", "value": "@entry"},
    {"pointer": "/processing/inputs/0/evidence_digest", "value": "$digest:span_bytes"},
    {"pointer": "/processing/inputs/0/permits/destinations/0/repository_id", "value": "@repo"}]},
  {"name": "capture_submit", "from": "c01/capture_request.json",
   "set": [
    {"pointer": "/request_id", "value": "@capture_request"},
    {"pointer": "/actor/principal_id", "value": "@me"},
    {"pointer": "/actor/device_id", "value": "@laptop"},
    {"pointer": "/actor/profile_id", "value": "@local_profile"},
    {"pointer": "/owner/repository_id", "value": "@repo"},
    {"pointer": "/target/resource_id", "value": "@decisions"},
    {"pointer": "/payload_digest", "value": "#capture"}]},
  {"name": "stored_capture", "from": "capture",
   "set": [{"pointer": "/captured_at", "value": "$instant:captured_at"}]},
  {"name": "run", "from": "c01/extraction_run_of_a_packaged_adapter.json",
   "set": [
    {"pointer": "/run_id", "value": "$run:distill_run"},
    {"pointer": "/ran_at", "value": "$instant:ran_at"}]},
  {"name": "candidate", "from": "c05/candidate_from_a_capture.json",
   "set": [
    {"pointer": "/destination_source_id", "value": "@decisions"},
    {"pointer": "/origin/capture_digest", "value": "#stored_capture"},
    {"pointer": "/origin/evidence_digests/0", "value": "$digest:span_bytes"},
    {"pointer": "/proposed/home/repository_id", "value": "@repo"},
    {"pointer": "/proposed/workstream_ids/0", "value": "@lane"},
    {"pointer": "/proposed/basis/0/source_id", "value": "@measured_source"}]},
  {"name": "candidate_submit", "from": "c03/candidate_request.json",
   "set": [
    {"pointer": "/request_id", "value": "@candidate_request"},
    {"pointer": "/actor/principal_id", "value": "@me"},
    {"pointer": "/actor/device_id", "value": "@laptop"},
    {"pointer": "/actor/profile_id", "value": "@local_profile"},
    {"pointer": "/owner/principal_id", "value": "@me"},
    {"pointer": "/target/resource_id", "value": "@me"},
    {"pointer": "/payload_digest", "value": "#candidate"}]},
  {"name": "stored_candidate", "from": "candidate",
   "set": [
    {"pointer": "/candidate_id", "value": "$cnd:candidate"},
    {"pointer": "/version", "value": 1},
    {"pointer": "/standing/is", "value": "candidate"},
    {"pointer": "/created_at", "value": "$instant:candidate_at"}]}
 ],
 "steps": [
  {"name": "observe_span", "request": "observe", "carries": ["selection"],
   "answer": {"stage": "previewed", "local_effect": "none", "provider_effect": "not_applicable",
