 "says": "A person binds this device's key and the checkout, then imports an architecture decision record from an inherited repository's ADR directory into a memory source of this repository (source.revision.admit, import_external_package with its declared origin, license conditions and exact package revision). The owner commits the revision and its provenance. The provenance keeps what the ADR says about its own history as claims, each with how far it is supported: its author 'Architecture group' as stated only, its decision date 2025-11-04 as verified against evidence, its status 'Accepted' and 'Approved by the platform council' as stated only. The person who imported it is not named as its author anywhere, and nothing is accepted: acceptance stays not_accepted and no Team receipt exists. Resolving the committed revision later returns the same manifest and the same provenance, so the ADR's status string and stated approval never became an acceptance by being imported, read or committed.",
 "spec_sha256": "a370bbb301704846fbd2b7988ee020b6846cfd934d5424b4682d8a173ee66c48",
 "steps": [
  {
   "carries": [
    "alice_key_submitted"
   ],
   "name": "bind_device_key",
   "request": "bind_key_request",
   "result": "bind_device_key_result",
   "returns": [
    "alice_key"
   ]
  },
  {
   "carries": [
    "repo_binding_submitted"
   ],
   "name": "bind_repository",
   "request": "bind_repo_request",
   "result": "bind_repository_result",
   "returns": [
    "repo_binding"
   ]
  },
  {
   "carries": [
    "import_request_payload"
   ],
   "head": "adr_head",
   "name": "import_adr",
   "request": "import_request",
   "result": "import_adr_result",
   "returns": [
    "adr_revision",
    "adr_provenance"
   ]
  },
  {
   "carries": [
    "adr_ref"
   ],
   "name": "resolve_imported_adr",
   "request": "resolve_request",
   "result": "resolve_imported_adr_result",
   "returns": [
    "adr_revision",
    "adr_provenance"
   ]
  }
 ]
}
