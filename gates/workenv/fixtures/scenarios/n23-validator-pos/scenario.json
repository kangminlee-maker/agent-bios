 ],
 "says": "A person commits a domain package holding the pinned lens table_consistency version 2 and its question, and a rates table to validate, each through source.revision.commit. The validator adapter (domain-lens-runner 1.4.0 on the agent_bios_validation wire) is probed for real: it loads the pinned lens by digest and returns findings, so the owner stores the probe (mode real, outcome worked) and a profile that qualifies validation by naming that probe. A validation request then pins exactly the committed rates revision as its target, the committed package by digest, the question and the lens by name, version and digest, expecting the head the commit moved to. The owner answers with a validation_run in real mode from that qualified validator, naming the request it ran, a check that ran for the one pinned target and lens, the finding it produced against that target, and the digest of the output the validator produced; every check it rests on ran, and nothing outside what the request pinned is checked.",
 "spec_sha256": "a62c739c2ea2a9afd000831794a069f8e8ad374f941b1ef3838c8b09a8a591c9",
 "steps": [
  {
   "carries": [
    "device_key"
   ],
   "name": "bind_device_key",
   "request": "bind_key",
   "result": "bind_device_key_result",
   "returns": [
    "stored_device_key"
   ]
  },
  {
   "carries": [
    "package_manifest"
   ],
   "head": "package_head",
   "name": "commit_the_domain_package",
   "request": "commit_package",
   "result": "commit_the_domain_package_result",
   "returns": [
    "stored_package"
   ]
  },
  {
   "carries": [
    "rates_manifest"
   ],
   "head": "rates_head",
   "name": "commit_the_rates_table",
   "request": "commit_rates",
   "result": "commit_the_rates_table_result",
   "returns": [
    "stored_rates"
   ]
  },
  {
   "carries": [
    "validator_probe"
   ],
   "name": "probe_the_validator",
   "request": "probe_validator",
   "result": "probe_the_validator_result",
   "returns": [
    "real_validator_probe",
    "validator_profile"
   ]
  },
  {
   "carries": [
    "validation"
   ],
   "name": "run_the_pinned_validation",
   "request": "validation_submit",
   "result": "run_the_pinned_validation_result",
