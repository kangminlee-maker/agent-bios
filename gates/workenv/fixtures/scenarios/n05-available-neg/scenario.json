 ],
 "says": "Alice's desktop and laptop are two isolated runtimes. On the desktop she binds its key, registers her private notes source and commits a revision on the head the registration made, then stages the package that carries that revision and its home for her laptop, trusted by the desktop's enrolment binding, which travels with it: the desktop records it exported. On the laptop, after binding the laptop's key, the same package is staged and recorded received. Querying that staging request on the laptop returns its original result: objects staged, stage draft, no receipt. The revision's member is readable on the laptop — resolving a reference to it returns the revision and its home — but the resolution is a preview on a source whose head the laptop still does not hold, not an acceptance. Only accepting the package commits it with a receipt and records the package committed, naming that receipt; querying the accept returns that result. What must not happen: an exported or received package, or members written without a receipt, reported as accepted or committed — no result before the accept names a receipt or a settled stage.",
 "spec_sha256": "3284442d636022cbf1e8c8d87a6ee30bc5b71c849e7a2cc8cf04fbbb7f720837",
 "steps": [
  {
   "carries": [
    "desktop_key"
   ],
   "name": "bind_desktop_key",
   "process": "desktop",
   "request": "bind_desktop",
   "result": "bind_desktop_key_result",
   "returns": [
    "stored_desktop_key"
   ]
  },
  {
   "carries": [
    "notes_home"
   ],
   "head": "notes_head_0",
   "name": "register_notes_home",
   "process": "desktop",
   "request": "register_home",
   "result": "register_notes_home_result",
   "returns": [
    "stored_home"
   ]
  },
  {
   "carries": [
    "revision"
   ],
   "head": "desktop_head",
   "name": "commit_on_the_desktop",
   "process": "desktop",
   "request": "commit",
   "result": "commit_on_the_desktop_result",
   "returns": [
    "stored_revision"
   ]
  },
  {
   "carries": [
    "package",
    "stored_revision",
    "stored_home",
    "stored_desktop_key"
   ],
   "name": "export_from_the_desktop",
   "process": "desktop",
   "request": "export",
   "result": "export_from_the_desktop_result",
   "returns": [
    "exported"
   ]
  },
  {
   "carries": [
    "laptop_key"
   ],
   "name": "bind_laptop_key",
   "process": "laptop",
   "request": "bind_laptop",
   "result": "bind_laptop_key_result",
   "returns": [
    "stored_laptop_key"
   ]
  },
  {
   "carries": [
    "package",
    "stored_revision",
    "stored_home",
    "stored_desktop_key"
   ],
   "name": "receive_on_the_laptop",
   "process": "laptop",
   "request": "receive",
   "result": "receive_on_the_laptop_result",
   "returns": [
    "received"
   ]
  },
  {
   "carries": [
    "receive_query"
   ],
   "name": "query_the_received_package",
   "process": "laptop",
   "request": "ask_receive",
   "result": "query_the_received_package_result",
   "returns": [
    "receive_on_the_laptop_result"
   ]
  },
  {
   "carries": [
    "member_ref"
   ],
   "name": "read_the_received_member",
   "process": "laptop",
   "request": "resolve",
   "result": "read_the_received_member_result",
   "returns": [
    "stored_revision",
    "stored_home",
    "rates_body"
   ]
  },
  {
   "carries": [
