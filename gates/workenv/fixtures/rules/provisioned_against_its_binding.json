{
  "rule": "C09/provisioned_against_its_binding",
  "holds": [
    {
      "what": "provisioned against the repository the binding names",
      "record": "workenv/contracts/examples/c09/carrier_provisioned_against_the_repository_it_verified.json",
      "context": {
        "binding": "workenv/contracts/examples/c09/carrier_bound_to_one_repository.json"
      }
    },
    {
      "what": "provisioned part way against the repository the binding names",
      "record": "workenv/contracts/examples/c09/carrier_provisioned_part_way.json",
      "context": {
        "binding": "workenv/contracts/examples/c09/carrier_bound_to_one_repository.json"
      }
    },
    {
      "what": "the provider reported another repository and the binding is left mismatched",
      "record": "workenv/contracts/examples/c09/carrier_whose_provider_reported_another_repository.json",
      "context": {
        "binding": "workenv/contracts/examples/c09/carrier_bound_to_one_repository.json"
      }
    },
    {
      "what": "bound, with nothing provisioned and no repository claimed",
      "record": "workenv/contracts/examples/c09/carrier_bound_and_nothing_provisioned.json",
      "context": {
        "binding": "workenv/contracts/examples/c09/carrier_bound_to_one_repository.json"
      }
    }
  ],
  "breaks": [
    {
      "what": "recorded provisioned against the repository the provider reported instead of the bound one",
      "record": {
        "binding_id": "car_87b7fadedc401398b68af07ee2fdc21f",
        "kind": "carrier_state",
        "observed_at": "2026-09-20T09:00:00Z",
        "schema": 1,
        "state": {
          "is": "provisioned",
          "repository_id": "701239999",
          "repository_rights": [
            "write"
          ]
        }
      },
      "context": {
        "binding": "workenv/contracts/examples/c09/carrier_bound_to_one_repository.json"
      },
      "at": [
        "/state/repository_id"
      ]
    },
    {
      "what": "part way against a repository the binding does not name",
      "record": {
        "binding_id": "car_87b7fadedc401398b68af07ee2fdc21f",
        "kind": "carrier_state",
        "observed_at": "2026-09-20T09:00:00Z",
        "schema": 1,
        "state": {
          "done": [
            "create_repository"
          ],
          "is": "partial",
          "missing": [
            "write_objects"
          ],
          "repository_id": "701239999"
        }
      },
      "context": {
        "binding": "workenv/contracts/examples/c09/carrier_bound_to_one_repository.json"
      },
      "at": [
        "/state/repository_id"
      ]
    },
    {
      "what": "mismatched although the provider reported the bound repository",
      "record": {
        "binding_id": "car_87b7fadedc401398b68af07ee2fdc21f",
        "kind": "carrier_state",
        "observed_at": "2026-09-20T09:00:00Z",
        "schema": 1,
        "state": {
          "is": "mismatched",
          "reported_repository_id": "701234567"
        }
      },
      "context": {
        "binding": "workenv/contracts/examples/c09/carrier_bound_to_one_repository.json"
      },
      "at": [
        "/state/reported_repository_id"
      ]
    },
    {
      "what": "a state for one binding held against another",
      "record": {
        "binding_id": "car_0c6f2b7e5a9d4c1e8b3f6a2d9e7c5b10",
        "kind": "carrier_state",
        "observed_at": "2026-09-20T09:00:00Z",
        "schema": 1,
        "state": {
          "is": "provisioned",
          "repository_id": "701234567",
          "repository_rights": [
            "write"
          ]
        }
      },
      "context": {
        "binding": "workenv/contracts/examples/c09/carrier_bound_to_one_repository.json"
      },
      "at": [
        "/binding_id"
      ]
    }
  ]
}
