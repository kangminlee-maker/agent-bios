{
  "title": "Case registry",
  "description": "What each test profile runs and what each case drives. A catalog id is kept verbatim; a new case is defined once as <FAMILY>-<SUBJECT>-<POS|NEG> and selected by the profiles whose scope it serves. Meaning a catalog entry already states is not restated here. Evidence class and polarity are derived, never written down. gates/workenv/cases.py holds the relations a schema cannot state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "driver",
    "carried",
    "bootstrap",
    "atomic",
    "cases",
    "selects",
    "covers",
    "given"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "driver": {
      "description": "The file the catalog's <conformance-driver> placeholder names, in the directory the plan reserves for it (gates/workenv/conformance/). A family case cannot run before it exists.",
      "const": "gates/workenv/conformance/driver.py"
    },
    "carried": {
      "description": "A binding an accepted record already holds, kept byte for byte so that record's binding_digest stays current.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/carried_binding"
      }
    },
    "bootstrap": {
      "description": "The catalog's bootstrap cases for profiles that are not carried: what runs each. A bootstrap case binds to its profile's only family.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/bootstrap_case"
      }
    },
    "atomic": {
      "description": "Every atomic case of the catalog. Its meaning and prerequisites are the catalog's; its scenario states what it drives.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/atomic_case"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/new_case"
      }
    },
    "selects": {
      "description": "Which new cases each profile runs, and catalog atomic cases it runs beyond its required ones. Required atomic and bootstrap selection stays in the catalog.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/selection"
      }
    },
    "covers": {
      "description": "What realizes each done_when item of every open profile's node.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "given": {
      "description": "Steps whose answer is the driver's at every profile that binds their case, accepted with the reason no profile holding the case's family can run them (D-20260924-f80d5c). Anything else such a step would be is bound at a later profile instead. gates/workenv/cases.py refuses a row that no longer matches.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/given_case"
      }
    }
  },
  "x-unique-by": {
    "key": "id",
    "across": [
      "bootstrap",
      "atomic",
      "cases"
    ]
  },
  "$defs": {
    "profile": {
      "type": "string",
      "pattern": "^(?:P[0-9]{2}|V[0-9]|PK|R0)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "family": {
      "type": "string",
      "pattern": "^[BN][0-9]{2}$"
    },
    "carried_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "family": {
          "$ref": "#/$defs/family"
        }
      }
    },
    "carried_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "binding_digest",
        "profile_digest",
        "adapter_fingerprint",
        "fixture_fingerprint",
        "cases"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "binding_digest": {
          "description": "The binding_digest the accepted record states. The binding rebuilt from the other fields must digest to it.",
          "$ref": "#/$defs/digest"
        },
        "profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "adapter_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "fixture_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/carried_case"
          }
        }
      },
      "x-unique-by": {
        "key": "id",
        "across": [
          "cases"
        ]
      }
    },
    "bootstrap_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[0-9]{2}-contract-(?:positive|negative)$"
        },
        "command": {
          "description": "argv; <prepared-python> is the one placeholder, filled with the runner's measured interpreter.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "contract": {
      "description": "An adapter contract: a contract module's CONTRACT value, or `runner` for the development runner's preflight interface.",
      "type": "string",
      "pattern": "^(?:[BC][0-9]{2}|runner)$"
    },
    "fixtures": {
      "description": "Files or directories (a trailing slash) under the two fixture roots, or the entrance dispositions, that a case reads besides its scenario. A directory stands for every file under it.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:(?:workenv/contracts/examples|gates/workenv/fixtures)(?:/[a-z0-9][a-z0-9_.-]*)+/?|gates/workenv/entrances\\.jsonl)$"
      }
    },
    "atomic_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+$"
        },
        "reads": {
          "$ref": "#/$defs/fixtures"
        }
      }
    },
    "new_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "oracle",
        "asserts"
      ],
      "properties": {
        "id": {
          "description": "<FAMILY>-<SUBJECT>-<POS|NEG>; the family and the polarity are read from it.",
          "type": "string",
          "pattern": "^N[0-9]{2}(?:-[A-Z0-9]+)+-(?:POS|NEG)$"
        },
        "oracle": {
          "description": "Index into the family's catalog oracles: which one this case holds the selecting profile to.",
          "type": "integer",
          "minimum": 0
        },
        "asserts": {
          "description": "What the driver checks over the case's scenario.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "rules": {
          "description": "Runtime rules contract modules declare, which this case checks over what the owner writes.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^C[0-9]{2}/[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "reads": {
          "$ref": "#/$defs/fixtures"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "cases"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/selected_case"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "done_when"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "done_when": {
          "description": "One list per done_when item of the profile's node, in order: the cases that realize it.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+$"
            }
          }
        },
        "elsewhere": {
          "description": "Each contract the node implements that none of its bound cases can drive, and why.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contract",
              "reason"
            ],
            "properties": {
              "contract": {
                "$ref": "#/$defs/contract"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "selected_case": {
      "description": "A case a profile may select: a new case's id, or a catalog atomic case's.",
      "type": "string",
      "pattern": "^(?:N[0-9]{2}(?:-[A-Z0-9]+)+-(?:POS|NEG)|[A-Z]+(?:-[A-Z0-9]+)+)$"
    },
    "given_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "steps",
        "reason"
      ],
      "properties": {
        "case": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
