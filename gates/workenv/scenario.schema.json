{
  "title": "Scenario spec",
  "description": "A case's scenario, written short. gates/workenv/scenarios.py generates the joined bytes beside it (scenario.json); the spec, the generator and the generated file are the case's fixture. Every record is a contract example with the leaves this case changes, so the examples are the vocabulary and a spec states only differences. A string value may name instead of state: \"@name\" an id from `ids`, \"#name\" the digest of a record from `records`, \"$shape:name\" a value the owner mints (shape is an id prefix, digest, instant or integer), first placed in a record a step's answer returns. `world` states what surrounds the steps: several isolated processes, a controlled clock, network partitions between processes, and a fault that kills a process at a named B03 fault point during a step and restarts it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case",
    "says",
    "ids",
    "records",
    "steps"
  ],
  "x-unique-by": {
    "key": "name",
    "across": [
      "ids",
      "records"
    ]
  },
  "properties": {
    "case": {
      "type": "string",
      "pattern": "^(?:N[0-9]{2}(?:-[A-Z0-9]+)+-(?:POS|NEG)|[A-Z]+(?:-[A-Z0-9]+)+)$"
    },
    "says": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "members": {
      "type": "array",
      "uniqueItems": true,
      "description": "Bytes of source members the scenario names: `#name` is the digest of those bytes, and a step whose operation returns `source_member` may return one.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "text"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "world": {
      "$ref": "#/$defs/world"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "pointer": {
      "type": "string",
      "pattern": "^(?:/[^/]+)+$"
    },
    "id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "prefix"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[a-z]{3}$"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "description": "Set one leaf. A missing parent is created — an array when the next segment is 0 or `-`, an object otherwise — and an index one past an array's end appends a new object there; `-` as the last segment appends a value to an array.",
      "required": [
        "pointer",
        "value"
      ],
      "properties": {
        "pointer": {
          "$ref": "#/$defs/pointer"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "description": "A contract example (`from`, a path under workenv/contracts/examples/) or another record of this spec (`from`, its name), with the leaves this case removes (`drop`, first) and sets (`set`, in order).",
      "required": [
        "name",
        "from"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "from": {
          "type": "string",
          "pattern": "^(?:[a-z0-9_]+/[a-z0-9_]+\\.json|[a-z][a-z0-9]*(?:_[a-z0-9]+)*)$"
        },
        "drop": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pointer"
          }
        },
        "set": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/answered_step"
        },
        {
          "$ref": "#/$defs/refused_step"
        },
        {
          "$ref": "#/$defs/runner_step"
        },
        {
          "$ref": "#/$defs/replayed_step"
        }
      ]
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "code",
        "pointer"
      ],
      "properties": {
        "record": {
          "$ref": "#/$defs/name"
        },
        "code": {
          "$ref": "#/$defs/name"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/[^/]*)*$"
        }
      }
    },
    "refused_step": {
      "type": "object",
      "additionalProperties": false,
      "description": "A submission refused at admission, before any result: the named records fail their schemas with exactly these refusals, and nothing is written.",
      "required": [
        "name",
        "request",
        "carries",
        "refused"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "request": {
          "$ref": "#/$defs/name"
        },
        "carries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "refused": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/refusal"
          }
        },
        "process": {
          "$ref": "#/$defs/name"
        },
        "advance_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "submits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "route": {
          "$ref": "#/$defs/route"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/name"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/[^/]*)*$"
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "description": "The result the owner writes, stated by what the contract fixes. The generator builds the operation_result from it and the request and holds it against the result schema, so an answer the contract cannot give cannot be written here either. A committed answer's receipt is generated as `<step>_receipt`; `head` names the head its receipt states: a record the answer returns, whose digest it is (a later base expects it as #<head>), or else a digest the owner mints (a later base expects it as $digest:<head>). `receipt_of` names an earlier committed step whose receipt this answer states instead of writing one (a duplicate answered under a new request id); it states no head.",
      "required": [
        "stage",
        "local_effect",
        "provider_effect",
        "gaps",
        "recovery",
        "returns"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "local_effect": {
          "type": "string"
        },
        "provider_effect": {
          "type": "string"
        },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gap"
          }
        },
        "recovery": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "returns": {
          "description": "The records the result names in `outputs`, each written as the owner stores it.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "head": {
          "$ref": "#/$defs/name"
        },
        "receipt_of": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "answered_step": {
      "type": "object",
      "additionalProperties": false,
      "description": "One request, admitted, and what its owner answers. `carries` are the records whose digests the request names (payload, policies, controls, proofs, recipient) or its payload names (a batch's item requests); a digest the request names must be one of them or a value an earlier step minted. `submits` names carried records, besides the payload, that are submitted with the request rather than held by the store (a new policy a founding proposal names); they are read in submit mode.",
      "required": [
        "name",
        "request",
        "carries",
        "answer"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "request": {
          "$ref": "#/$defs/name"
        },
        "carries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "process": {
          "$ref": "#/$defs/name"
        },
        "advance_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "submits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "route": {
          "$ref": "#/$defs/route"
        }
      }
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "description": "The harness around the steps, not a contract record. With `processes`, every step names the process it runs on, each an isolated runtime with its own state root. With `clock`, the driver controls time: it starts at `start` and a step moves it by `advance_seconds` before it runs. With `during`, a step runs while another is in flight. With `events`, the harness makes outside changes between steps.",
      "properties": {
        "processes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/instant"
            }
          }
        },
        "partitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/partition"
          }
        },
        "faults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fault"
          }
        },
        "during": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/during"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "description": "The two processes cannot reach each other from step `from` up to, not including, step `until`; without `until`, to the end.",
      "required": [
        "between",
        "from"
      ],
      "properties": {
        "between": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "from": {
          "$ref": "#/$defs/name"
        },
        "until": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "description": "The process running step `step` is killed at `point` (a name B03's FAULT_POINTS declares) and restarted; the step's answer is what the owner returns for the same request after the restart. With `observed_by`, the caller does not resubmit: no reply reaches it, and it first learns the answer from that later step, which returns `<step>_result`.",
      "required": [
        "step",
        "point"
      ],
      "properties": {
        "step": {
          "$ref": "#/$defs/name"
        },
        "point": {
          "$ref": "#/$defs/name"
        },
        "observed_by": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "runner_step": {
      "type": "object",
      "additionalProperties": false,
      "description": "One situation of this case in gates/workenv/fixtures/runner/preflight.json: the driver builds it, invokes the runner under qualification, and applies the checks the preflight states.",
      "required": [
        "name",
        "runner"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "runner": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "replayed_step": {
      "type": "object",
      "additionalProperties": false,
      "description": "The same request bytes as an earlier answered step, submitted again: the owner answers with that step's result and receipt and writes nothing new.",
      "required": [
        "name",
        "request",
        "carries",
        "replays"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "request": {
          "$ref": "#/$defs/name"
        },
        "carries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "submits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "replays": {
          "$ref": "#/$defs/name"
        },
        "process": {
          "$ref": "#/$defs/name"
        },
        "advance_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "route": {
          "$ref": "#/$defs/route"
        }
      }
    },
    "during": {
      "type": "object",
      "additionalProperties": false,
      "description": "Step `runs`, listed immediately before `step`, starts after the owner admitted `step`'s request and commits before the owner answers it: the driver holds `step` after admission, runs `runs` to its answer, then lets `step` finish. `step`'s request uses nothing `runs` mints.",
      "required": [
        "step",
        "runs"
      ],
      "properties": {
        "step": {
          "$ref": "#/$defs/name"
        },
        "runs": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "event": {
      "description": "An outside change the harness makes, never a contract record. Every kind but `reply_lost` happens after the previous step and before the step `before` names; a record an event names is one of the spec's records.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "A file at `path` in the checkout or root the step reads now holds `bytes` (UTF-8 text), or with `absent` no longer exists. The generated event states the digest and size of `bytes`.",
          "required": [
            "kind",
            "before",
            "path"
          ],
          "properties": {
            "kind": {
              "enum": [
                "file_edit"
              ]
            },
            "before": {
              "$ref": "#/$defs/name"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "bytes": {
              "type": "string"
            },
            "absent": {
              "enum": [
                true
              ]
            },
            "process": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The package the step `before` accepts reaches the receiver with member `path` holding `bytes` instead of what its inventory advertises; with `executable`, the member arrives marked executable. The generated event states the digest and size of `bytes`.",
          "required": [
            "kind",
            "before",
            "path",
            "bytes"
          ],
          "properties": {
            "kind": {
              "enum": [
                "received_bytes"
              ]
            },
            "before": {
              "$ref": "#/$defs/name"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "bytes": {
              "type": "string"
            },
            "executable": {
              "enum": [
                true
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The identity provider of record `connection` delivers a refreshed token or callback to the runtime with no local access transition.",
          "required": [
            "kind",
            "before",
            "connection"
          ],
          "properties": {
            "kind": {
              "enum": [
                "provider_refresh"
              ]
            },
            "before": {
              "$ref": "#/$defs/name"
            },
            "connection": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The key files and agent around record `key` are arranged as `layout` names: the private key file beside the public one, the signing agent one the runtime does not own, or the arrangement the runtime expects, the public key alone with the private half held by the agent the runtime owns.",
          "required": [
            "kind",
            "before",
            "key",
            "layout"
          ],
          "properties": {
            "kind": {
              "enum": [
                "key_layout"
              ]
            },
            "before": {
              "$ref": "#/$defs/name"
            },
            "key": {
              "$ref": "#/$defs/name"
            },
            "layout": {
              "enum": [
                "private_beside_public",
                "foreign_agent",
                "owned_agent"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The store's `setting` is configured to `value` before the step runs.",
          "required": [
            "kind",
            "before",
            "setting",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "configure"
              ]
            },
            "before": {
              "$ref": "#/$defs/name"
            },
            "setting": {
              "enum": [
                "recovery_objective_seconds"
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The harness packs the checkout as it stands; record `yields` states what that build produced, and the driver compares it with the real output.",
          "required": [
            "kind",
            "before",
            "yields"
          ],
          "properties": {
            "kind": {
              "enum": [
                "build"
              ]
            },
            "before": {
              "$ref": "#/$defs/name"
            },
            "yields": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The harness takes the inventory of `root`: the source checkout, the installed target, or the knowledge package the product ships, found where the product's own install route finds it. Record `yields` states it, or it must equal what an earlier inventory yielded (`equals`).",
          "required": [
            "kind",
            "before",
            "root"
          ],
          "properties": {
            "kind": {
              "enum": [
                "inventory"
              ]
            },
            "before": {
              "$ref": "#/$defs/name"
            },
            "root": {
              "enum": [
                "checkout",
                "installed",
                "shipped_knowledge"
              ]
            },
            "yields": {
              "$ref": "#/$defs/name"
            },
            "equals": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The external provider completes the effect of step `step`, and its reply never reaches the runtime; the step's answer is what the owner records without it.",
          "required": [
            "kind",
            "step"
          ],
          "properties": {
            "kind": {
              "enum": [
                "reply_lost"
              ]
            },
            "step": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The carrier provider, asked at step `before` about the binding's repository, reports `repository_id` as that repository's identity.",
          "required": [
            "kind",
            "before",
            "repository_id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "carrier_reports"
              ]
            },
            "before": {
              "$ref": "#/$defs/name"
            },
            "repository_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "description": "The concrete route the request is submitted through: a row of gates/workenv/entrances.jsonl, matched by path and command. `root_override` names the root the caller chose instead of its own (the `--repo` argument or the `AGENT_BIOS_STATE_DIR` environment variable), on a route whose disposition takes its root from the caller.",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "root_override": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "root"
          ],
          "properties": {
            "by": {
              "enum": [
                "repo_argument",
                "state_dir_environment"
              ]
            },
            "root": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
