{
  "title": "Scenario spec",
  "description": "A case's scenario, written short. gates/workenv/scenarios.py generates the joined bytes beside it (scenario.json); the spec, the generator and the generated file are the case's fixture. Every record is a contract example with the leaves this case changes, so the examples are the vocabulary and a spec states only differences. A string value may name instead of state: \"@name\" an id from `ids`, \"#name\" the digest of a record from `records`, \"$shape:name\" a value the owner mints (shape is an id prefix, digest, instant or integer), first placed in a record a step's answer returns. `world` states what surrounds the steps: several isolated processes, a controlled clock, network partitions between processes, and a fault that kills a process at a named B03 fault point during a step and restarts it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case",
    "says",
    "ids",
    "records",
    "steps"
  ],
  "x-unique-by": {
    "key": "name",
    "across": [
      "ids",
      "records"
    ]
  },
  "properties": {
    "case": {
      "type": "string",
      "pattern": "^(?:N[0-9]{2}(?:-[A-Z0-9]+)+-(?:POS|NEG)|[A-Z]+(?:-[A-Z0-9]+)+)$"
    },
    "says": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "world": {
      "$ref": "#/$defs/world"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "pointer": {
      "type": "string",
      "pattern": "^(?:/[^/]+)+$"
    },
    "id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "prefix"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[a-z]{3}$"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "description": "Set one leaf. A missing parent is created — an array when the next segment is 0 or `-`, an object otherwise — and an index one past an array's end appends a new object there; `-` as the last segment appends a value to an array.",
      "required": [
        "pointer",
        "value"
      ],
      "properties": {
        "pointer": {
          "$ref": "#/$defs/pointer"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "description": "A contract example (`from`, a path under workenv/contracts/examples/) or another record of this spec (`from`, its name), with the leaves this case removes (`drop`, first) and sets (`set`, in order).",
      "required": [
        "name",
        "from"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "from": {
          "type": "string",
          "pattern": "^(?:[a-z0-9_]+/[a-z0-9_]+\\.json|[a-z][a-z0-9]*(?:_[a-z0-9]+)*)$"
        },
        "drop": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pointer"
          }
        },
        "set": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/answered_step"
        },
        {
          "$ref": "#/$defs/refused_step"
        },
        {
          "$ref": "#/$defs/runner_step"
        },
        {
          "$ref": "#/$defs/replayed_step"
        }
      ]
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "code",
        "pointer"
      ],
      "properties": {
        "record": {
          "$ref": "#/$defs/name"
        },
        "code": {
          "$ref": "#/$defs/name"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/[^/]*)*$"
        }
      }
    },
    "refused_step": {
      "type": "object",
      "additionalProperties": false,
      "description": "A submission refused at admission, before any result: the named records fail their schemas with exactly these refusals, and nothing is written.",
      "required": [
        "name",
        "request",
        "carries",
        "refused"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "request": {
          "$ref": "#/$defs/name"
        },
        "carries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "refused": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/refusal"
          }
        },
        "process": {
          "$ref": "#/$defs/name"
        },
        "advance_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "submits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/name"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/[^/]*)*$"
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "description": "The result the owner writes, stated by what the contract fixes. The generator builds the operation_result from it and the request and holds it against the result schema, so an answer the contract cannot give cannot be written here either. A committed answer's receipt is generated as `<step>_receipt`; `head` names the head_digest it states, so a later request's base can expect it as $digest:<head>.",
      "required": [
        "stage",
        "local_effect",
        "provider_effect",
        "gaps",
        "recovery",
        "returns"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "local_effect": {
          "type": "string"
        },
        "provider_effect": {
          "type": "string"
        },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gap"
          }
        },
        "recovery": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "returns": {
          "description": "The records the result names in `outputs`, each written as the owner stores it.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "head": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "answered_step": {
      "type": "object",
      "additionalProperties": false,
      "description": "One request, admitted, and what its owner answers. `carries` are the records whose digests the request names (payload, policies, controls, proofs, recipient) or its payload names (a batch's item requests); a digest the request names must be one of them or a value an earlier step minted. `submits` names carried records, besides the payload, that are submitted with the request rather than held by the store (a new policy a founding proposal names); they are read in submit mode.",
      "required": [
        "name",
        "request",
        "carries",
        "answer"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "request": {
          "$ref": "#/$defs/name"
        },
        "carries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "process": {
          "$ref": "#/$defs/name"
        },
        "advance_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "submits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "description": "The harness around the steps, not a contract record. With `processes`, every step names the process it runs on, each an isolated runtime with its own state root. With `clock`, the driver controls time: it starts at `start` and a step moves it by `advance_seconds` before it runs.",
      "properties": {
        "processes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/instant"
            }
          }
        },
        "partitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/partition"
          }
        },
        "faults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fault"
          }
        }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "description": "The two processes cannot reach each other from step `from` up to, not including, step `until`; without `until`, to the end.",
      "required": [
        "between",
        "from"
      ],
      "properties": {
        "between": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "from": {
          "$ref": "#/$defs/name"
        },
        "until": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "description": "The process running step `step` is killed at `point` (a name B03's FAULT_POINTS declares) and restarted; the step's answer is what the owner returns for the same request after the restart.",
      "required": [
        "step",
        "point"
      ],
      "properties": {
        "step": {
          "$ref": "#/$defs/name"
        },
        "point": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "runner_step": {
      "type": "object",
      "additionalProperties": false,
      "description": "One situation of this case in gates/workenv/fixtures/runner/preflight.json: the driver builds it, invokes the runner under qualification, and applies the checks the preflight states.",
      "required": [
        "name",
        "runner"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "runner": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "replayed_step": {
      "type": "object",
      "additionalProperties": false,
      "description": "The same request bytes as an earlier answered step, submitted again: the owner answers with that step's result and receipt and writes nothing new.",
      "required": [
        "name",
        "request",
        "carries",
        "replays"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "request": {
          "$ref": "#/$defs/name"
        },
        "carries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "submits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "replays": {
          "$ref": "#/$defs/name"
        },
        "process": {
          "$ref": "#/$defs/name"
        },
        "advance_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
