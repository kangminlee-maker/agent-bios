{
  "title": "Scenario spec",
  "description": "A case's scenario, written short. gates/workenv/scenarios.py generates the joined bytes beside it (scenario.json); the spec, the generator and the generated file are the case's fixture. Every record is a contract example with the leaves this case changes, so the examples are the vocabulary and a spec states only differences. A string value may name instead of state: \"@name\" an id from `ids`, \"#name\" the digest of a record from `records`, \"$shape:name\" a value the owner mints (shape is an id prefix, digest, instant or integer), first placed in a record a step's answer returns.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case",
    "says",
    "ids",
    "records",
    "steps"
  ],
  "x-unique-by": {
    "key": "name",
    "across": [
      "ids",
      "records"
    ]
  },
  "properties": {
    "case": {
      "type": "string",
      "pattern": "^N[0-9]{2}(?:-[A-Z0-9]+)+-(?:POS|NEG)$"
    },
    "says": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "pointer": {
      "type": "string",
      "pattern": "^(?:/[^/]+)+$"
    },
    "id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "prefix"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[a-z]{3}$"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "description": "Set one leaf. A missing parent object is created; `-` as the last segment appends to an array.",
      "required": [
        "pointer",
        "value"
      ],
      "properties": {
        "pointer": {
          "$ref": "#/$defs/pointer"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "description": "A contract example (`from`, a path under workenv/contracts/examples/) with the leaves this case removes (`drop`, first) and sets (`set`, in order).",
      "required": [
        "name",
        "from"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "from": {
          "type": "string",
          "pattern": "^[a-z0-9_]+/[a-z0-9_]+\\.json$"
        },
        "drop": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pointer"
          }
        },
        "set": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/answered_step"
        },
        {
          "$ref": "#/$defs/refused_step"
        }
      ]
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "code",
        "pointer"
      ],
      "properties": {
        "record": {
          "$ref": "#/$defs/name"
        },
        "code": {
          "$ref": "#/$defs/name"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/[^/]*)*$"
        }
      }
    },
    "refused_step": {
      "type": "object",
      "additionalProperties": false,
      "description": "A submission refused at admission, before any result: the named records fail their schemas with exactly these refusals, and nothing is written.",
      "required": [
        "name",
        "request",
        "carries",
        "refused"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "request": {
          "$ref": "#/$defs/name"
        },
        "carries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "refused": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/refusal"
          }
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/name"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/[^/]*)*$"
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "description": "The result the owner writes, stated by what the contract fixes. The generator builds the operation_result from it and the request and holds it against the result schema, so an answer the contract cannot give cannot be written here either.",
      "required": [
        "stage",
        "local_effect",
        "provider_effect",
        "gaps",
        "recovery",
        "returns"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "local_effect": {
          "type": "string"
        },
        "provider_effect": {
          "type": "string"
        },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gap"
          }
        },
        "recovery": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "returns": {
          "description": "The records the result names in `outputs`, each written as the owner stores it.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "answered_step": {
      "type": "object",
      "additionalProperties": false,
      "description": "One request, admitted, and what its owner answers. `carries` are the records whose digests the request names (payload, policies, controls, proofs, recipient); a digest the request names must be one of them or a value an earlier step minted.",
      "required": [
        "name",
        "request",
        "carries",
        "answer"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "request": {
          "$ref": "#/$defs/name"
        },
        "carries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "answer": {
          "$ref": "#/$defs/answer"
        }
      }
    }
  }
}
