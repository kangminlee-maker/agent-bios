{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "design §11 (one instance: an occasion found and judged), with basis from design §5.4 set by code over the claim's scope; the field list is the implementation plan's WP-08 artifacts",
  "title": "Observation instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["expected_id", "occasion_locator", "exposure", "verdict", "basis", "evidence_ids"],
  "properties": {
    "expected_id": {"type": "string", "minLength": 1},
    "occasion_locator": {"type": "string", "minLength": 1},
    "exposure": {"type": "string", "enum": ["eligible", "exposure_unknown"]},
    "verdict": {"type": "string", "enum": ["observed", "not_observed"]},
    "basis": {"type": "string", "enum": ["incomplete", "view", "source"]},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
