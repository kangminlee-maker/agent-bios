{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "design §7.1 and §7.4, plan WP-09 Artifacts: intake.json, the lifecycle candidates code derives before formation, each with its source and an id of its own (<source>:<target>), and what the intake says beside them. Written by session-distill/runlib/lifecycle_intake.py; the sources equal stage_form.INTAKE_SOURCES (done-when 7).",
  "title": "S4 lifecycle intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["window", "ledger", "candidates", "notes", "counts"],
  "properties": {
    "window": {"type": "object", "additionalProperties": false, "required": ["start", "end", "tz"],
               "properties": {"start": {"type": "string"}, "end": {"type": "string"}, "tz": {"type": "string"}}},
    "ledger": {"type": "object", "additionalProperties": false, "required": ["sha256", "read"],
               "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "read": {"type": "string", "minLength": 1}}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "notes": {"type": "object", "additionalProperties": false, "required": ["obsolete_hint", "g_cluster_arc", "excluded_layers", "library_units"],
              "properties": {"obsolete_hint": {"type": ["string", "null"]}, "g_cluster_arc": {"type": "string"},
                             "library_units": {"type": "object", "additionalProperties": false,
                                               "required": ["eligible", "identical_copies_folded", "below_min_keys"],
                                               "properties": {"eligible": {"type": "integer", "minimum": 0},
                                                              "identical_copies_folded": {"type": "integer", "minimum": 0},
                                                              "below_min_keys": {"type": "integer", "minimum": 0}}},
                             "excluded_layers": {"type": "object", "additionalProperties": false,
                                                 "patternProperties": {"^[a-z_]+$": {"type": "object", "additionalProperties": false,
                                                   "required": ["operative_units", "reason"],
                                                   "properties": {"operative_units": {"type": "integer", "minimum": 0},
                                                                  "reason": {"type": "string", "minLength": 1}}}}}}},
    "counts": {"type": "object", "additionalProperties": false,
               "required": ["due_decision", "legacy", "obsolete_hint", "redundancy_hint", "g_cluster"],
               "properties": {"due_decision": {"type": "integer", "minimum": 0}, "legacy": {"type": "integer", "minimum": 0},
                              "obsolete_hint": {"type": "integer", "minimum": 0}, "redundancy_hint": {"type": "integer", "minimum": 0},
                              "g_cluster": {"type": "integer", "minimum": 0}}}
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "source"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^(due_decision|legacy|obsolete_hint|redundancy_hint|g_cluster):.+$"},
        "source": {"type": "string", "enum": ["due_decision", "legacy", "obsolete_hint", "redundancy_hint", "g_cluster"]},
        "target_entry": {"type": "string", "minLength": 1},
        "target_unit": {"type": "string", "minLength": 1},
        "target_units": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
        "resolves": {"type": ["string", "null"]},
        "entry_status": {"type": "string"},
        "expiry": {"type": "string"},
        "pending_intervention": {"type": "boolean"},
        "occasions": {"type": "object", "additionalProperties": false, "required": ["instances", "resolution"],
                      "properties": {"instances": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                       "required": ["occasion_locator", "exposure", "verdict", "basis"],
                                       "properties": {"occasion_locator": {"type": "string"}, "exposure": {"type": "string"},
                                                      "verdict": {"type": "string"}, "basis": {"type": "string"}}}},
                                     "resolution": {"type": ["string", "null"]}}},
        "marks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "type": {"type": ["string", "null"]},
        "windows_without_match": {"type": "integer", "minimum": 3},
        "similarity": {"type": "number"},
        "entries": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "lessons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
