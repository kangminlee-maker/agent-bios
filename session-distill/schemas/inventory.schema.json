{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "design §6.1: the unit record a reference point's inventory carries, and the layers it answers for. This file is the authority the code is held against; the design section it was derived from is provenance, not an executable contract, because a dated record is a claim about a past tree and is superseded as a matter of course.",
  "$ref": "#/$defs/document_kind",
  "$defs": {
    "current_document": {
      "$comment": "A reference point's document, judged on its units and layer rows. One root per published document, each naming its kind as a `document` const (step 0 S-21); the code's DOCUMENT_ROOTS picks it, because this schema policy has no oneOf.",
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "units", "layers", "scopes", "scope_universe"],
      "properties": {
        "document": {"const": "current"},
        "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
        "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layer_row"}},
        "scopes": {"type": "array", "items": {"$ref": "#/$defs/scope_answer"}},
        "scope_universe": {"type": "array", "items": {"$ref": "#/$defs/scope_universe"}}
      }
    },
    "release_document": {
      "$comment": "`release.json`, the segment index (step 0 S-17, #8): per census session, each segment of each of its owners with one row per layer, or a row set of its own for a session no segment covers. It never picks one segment and never unions versions: a row points into a shared inventory or at the in-force event, and copies no unit. Validated whole.",
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "produced_by", "sessions"],
      "properties": {
        "document": {"const": "release"},
        "produced_by": {"type": "object", "additionalProperties": false, "required": ["module", "design", "commit"],
                        "properties": {"module": {"type": "string"}, "design": {"type": "string"},
                                       "commit": {"type": ["string", "null"]}}},
        "sessions": {"type": "array", "items": {"$ref": "#/$defs/release_session"}}
      }
    },
    "release_session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_ref", "segments", "unsegmented"],
      "properties": {
        "session_ref": {"$ref": "#/$defs/session_ref"},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/release_segment"}},
        "unsegmented": {"$ref": "#/$defs/release_rows"}
      }
    },
    "release_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_ref", "inventory_refs", "layers", "complete", "incomplete_reasons"],
      "properties": {
        "segment_ref": {"$ref": "#/$defs/segment_id"},
        "inventory_refs": {"type": "array", "items": {"$ref": "#/$defs/inventory_id"}},
        "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/release_row"}},
        "complete": {"type": "boolean"},
        "incomplete_reasons": {"type": "array", "items": {"$ref": "#/$defs/release_incomplete"}}
      }
    },
    "release_rows": {
      "$comment": "the row set of a session no segment covers (R3), or null",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["inventory_refs", "layers", "complete", "incomplete_reasons"],
      "properties": {
        "inventory_refs": {"type": "array", "items": {"$ref": "#/$defs/inventory_id"}},
        "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/release_row"}},
        "complete": {"type": "boolean"},
        "incomplete_reasons": {"type": "array", "items": {"$ref": "#/$defs/release_incomplete"}}
      }
    },
    "release_row": {
      "$comment": "one layer of one segment: its status, its reasons as declared keys (an uncertain one prefixed `uncertain: `, S-21), and its source, or null",
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "status", "reasons", "source"],
      "properties": {
        "layer": {"$ref": "#/$defs/layer_name"},
        "status": {"type": "string", "enum": ["complete", "incomplete", "unsupported", "unknown"]},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source": {"$ref": "#/$defs/release_source"}
      }
    },
    "release_source": {
      "$comment": "one shared inventory's row of the layer ({inventory_ref, layer}), the in-force event's own members of the layer ({event_ref, members}), that event's occurrences ({event_ref, occurrence_refs}), or null",
      "type": ["object", "null"],
      "additionalProperties": false,
      "minProperties": 2,
      "dependentRequired": {"inventory_ref": ["layer"], "layer": ["inventory_ref"], "members": ["event_ref"],
                            "occurrence_refs": ["event_ref"]},
      "properties": {
        "inventory_ref": {"$ref": "#/$defs/inventory_id"},
        "layer": {"type": "string", "enum": ["catalog", "adopted_packages", "overlays"]},
        "event_ref": {"$ref": "#/$defs/event_id"},
        "members": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["carrier_id", "version_sha256"],
          "properties": {"carrier_id": {"type": "string", "pattern": "^c-[0-9a-f]{24}$"},
                         "version_sha256": {"$ref": "#/$defs/sha256"}}}},
        "occurrence_refs": {"type": "array", "items": {"type": "string", "pattern": "^q-[0-9a-f]{24}$"}}
      }
    },
    "release_incomplete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "status", "reasons", "inventory_ref"],
      "properties": {
        "layer": {"$ref": "#/$defs/layer_name"},
        "status": {"type": "string", "enum": ["incomplete", "unsupported", "unknown"]},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "inventory_ref": {"type": ["string", "null"], "pattern": "^i-[0-9a-f]{24}$"}
      }
    },
    "selection_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "units", "layers"],
      "properties": {
        "document": {"const": "selection"},
        "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
        "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layer_row"}}
      }
    },
    "sessions_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "span_unit", "produced_by", "sessions", "events", "segments", "occurrences"],
      "properties": {
        "document": {"const": "sessions"},
        "span_unit": {"$comment": "the unit an occurrence's start and end count, in the decoded text of the FIELD its pointer names; a different coordinate from the store's, which counts in a carrier version's raw text", "const": "code_point"},
        "produced_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "design", "commit"],
          "properties": {
            "module": {"type": "string"},
            "design": {"type": "string"},
            "commit": {"type": ["string", "null"]}
          }
        },
        "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
        "occurrences": {"type": "array", "items": {"$ref": "#/$defs/occurrence"}}
      }
    },
    "shared_inventory_document": {
      "$comment": "`shared/<selection|release>-<i>.json` (step 0 S-22): one per verified snapshot and per baseline a session's own pin names. Its layer rows, the carrier versions and units it holds by reference into shared/store.json, a selection's unavailable list (ref among the snapshot's own items, surface among the catalog's SURFACES) and a release's baseline items its units do not map.",
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "inventory_id", "kind", "ref", "complete", "incomplete_reasons", "produced_by", "layers",
                   "carriers", "unit_refs"],
      "properties": {
        "document": {"const": "shared_inventory"},
        "inventory_id": {"$ref": "#/$defs/inventory_id"},
        "kind": {"type": "string", "enum": ["selection", "release"]},
        "ref": {"type": "string", "minLength": 1},
        "complete": {"type": "boolean"},
        "incomplete_reasons": {"type": "array", "items": {"type": "string"}},
        "produced_by": {"type": "object", "additionalProperties": false, "required": ["module", "design", "commit"],
                        "properties": {"module": {"type": "string"}, "design": {"type": "string"},
                                       "commit": {"type": ["string", "null"]}}},
        "layers": {"type": "array", "items": {"$ref": "#/$defs/layer_row"}},
        "carriers": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["carrier_id", "version_sha256"],
          "properties": {"carrier_id": {"type": "string", "pattern": "^c-[0-9a-f]{24}$"},
                         "version_sha256": {"$ref": "#/$defs/sha256"}}}},
        "unit_refs": {"type": "array", "items": {"$ref": "#/$defs/unit_ref"}},
        "unavailable": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["ref", "surface", "reason"],
          "properties": {"ref": {"type": "string"}, "surface": {"type": "string"}, "reason": {"type": "string"}}}},
        "baseline_unmapped": {"type": "array", "items": {"type": "string"}},
        "baseline_items_expected": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "inventory_id": {"type": "string", "pattern": "^i-[0-9a-f]{24}$"},
    "segment_id": {"type": "string", "pattern": "^g-[0-9a-f]{24}$"},
    "in_force": {
      "$comment": "one kind's state over a segment (step 0 S-17): the event in force, none recorded yet, the one in force past its certainty cut (the line named), or a kind nobody could look for, by its reason",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "event_ref", "reason", "line"],
      "properties": {
        "state": {"enum": ["in_force", "no_event_yet", "uncertain", "unsought"]},
        "event_ref": {"type": ["string", "null"], "pattern": "^e-[0-9a-f]{24}$"},
        "reason": {"type": ["string", "null"], "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "segment": {
      "$comment": "an owner's line interval [from, to) of its transcript in which the event in force of each kind is fixed (step 0 S-17); one owner's segments partition [1, lines_read + 1)",
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "session_ref", "owner_ref", "from", "to", "in_force"],
      "properties": {
        "segment_id": {"$ref": "#/$defs/segment_id"},
        "session_ref": {"$ref": "#/$defs/session_ref"},
        "owner_ref": {"$ref": "#/$defs/owner_ref"},
        "from": {"$ref": "#/$defs/line"},
        "to": {"$ref": "#/$defs/line"},
        "in_force": {
          "type": "object",
          "additionalProperties": false,
          "required": ["native", "session_injection"],
          "properties": {
            "native": {"$ref": "#/$defs/in_force"},
            "session_injection": {"$ref": "#/$defs/in_force"}
          }
        }
      }
    },
    "shared_store_document": {
      "$comment": "`shared/store.json` (step 0 S-22): every carrier version the run names, once, keyed by carrier_id and then version_sha256, and every unit keyed by its unit_ref.",
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "span_unit", "produced_by", "versions", "units"],
      "properties": {
        "document": {"const": "shared_store"},
        "span_unit": {"$comment": "the unit every start and end counts, in the version's raw text", "const": "code_point"},
        "produced_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "design", "commit"],
          "properties": {
            "module": {"type": "string"},
            "design": {"type": "string"},
            "commit": {"type": ["string", "null"]}
          }
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^c-[0-9a-f]{24}$": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "patternProperties": {"^[0-9a-f]{64}$": {"$ref": "#/$defs/carrier_version"}}
            }
          }
        },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {"^r-[0-9a-f]{24}$": {"$ref": "#/$defs/carrier_unit"}}
        }
      }
    },
    "document_kind": {
      "$comment": "The file's own root. A document is validated against the $defs root its `document` names (the code's DOCUMENT_ROOTS); validated here, every real document is refused on purpose, because without oneOf no single root can admit them all.",
      "type": "object",
      "additionalProperties": false,
      "required": ["document"],
      "properties": {
        "document": {"type": "string", "enum": ["current", "release", "selection", "sessions", "shared_store",
                                                "shared_inventory"]}
      }
    },
    "event_id": {"type": "string", "pattern": "^e-[0-9a-f]{24}$"},
    "unit_ref": {
      "$comment": "opaque (step 0 S-11): r- over [\"unit\", carrier_id, version_sha256, n], n the block's 1-based position in that version",
      "type": "string",
      "pattern": "^r-[0-9a-f]{24}$"
    },
    "git": {
      "$comment": "What a Codex session_meta records of its repository (step 0 S-19); the URL's userinfo is removed before the floor.",
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_hash", "branch", "repository_url"],
      "properties": {
        "commit_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$"},
        "branch": {"type": ["string", "null"]},
        "repository_url": {"type": ["string", "null"]}
      }
    },
    "occurrence": {
      "$comment": "One recorded occurrence of a carrier version in an event (step 0 S-12, S-13). [start, end) counts code points of the decoded field text the pointer names. An unmapped occurrence (a normalised match whose offsets could not be recovered) carries no version, span or digest, and the reason recorded_unmapped.",
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence_id", "event_id", "ordinal", "pointer", "carrier_id", "version_sha256", "start", "end",
                   "sha256", "method", "reason"],
      "properties": {
        "occurrence_id": {"type": "string", "pattern": "^q-[0-9a-f]{24}$"},
        "event_id": {"$ref": "#/$defs/event_id"},
        "ordinal": {"type": "integer", "minimum": 0},
        "pointer": {"type": "string", "minLength": 1},
        "carrier_id": {"type": "string", "pattern": "^c-[0-9a-f]{24}$"},
        "version_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "start": {"type": ["integer", "null"], "minimum": 0},
        "end": {"type": ["integer", "null"], "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "method": {"type": "string", "enum": ["field", "exact", "normalised", "unmapped"]},
        "reason": {"type": ["string", "null"], "enum": ["recorded_unmapped", null]},
        "git": {"$ref": "#/$defs/git"}
      }
    },
    "carrier_version": {
      "$comment": "One carrier version in the store. `length` is the raw text's length in Unicode code points; `unit_refs` lists its units in order; `split` says whether the splitter read it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "path", "item_ref", "package_id", "form", "length", "split", "unit_refs"],
      "properties": {
        "layer": {"$ref": "#/$defs/layer_name"},
        "path": {"type": "string", "minLength": 1},
        "item_ref": {"type": ["string", "null"]},
        "package_id": {"type": ["string", "null"]},
        "form": {"type": "string", "enum": ["markdown", "python", "json", "toml", "plain"]},
        "length": {"type": "integer", "minimum": 0},
        "split": {"type": "string", "enum": ["split", "malformed", "unsupported"]},
        "unit_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/unit_ref"}}
      }
    },
    "carrier_unit": {
      "$comment": "A context-free unit of one carrier version. [start, end) is its span in the version's RAW text, in Unicode code points; `sha` is the raw fragment's sha256, and `text` its projection.",
      "type": "object",
      "additionalProperties": false,
      "required": ["carrier_id", "version_sha256", "n", "start", "end", "sha", "heading", "text", "class", "block",
                   "redaction_version"],
      "properties": {
        "carrier_id": {"type": "string", "pattern": "^c-[0-9a-f]{24}$"},
        "version_sha256": {"$ref": "#/$defs/sha256"},
        "n": {"type": "integer", "minimum": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "sha": {"$ref": "#/$defs/sha256"},
        "heading": {"type": "string"},
        "text": {"type": "string"},
        "class": {"type": "string", "enum": ["operative", "reference"]},
        "block": {"type": "string", "minLength": 1},
        "redaction_version": {"type": "string", "pattern": "^r[0-9]+$"}
      }
    },
    "scope_id": {"type": "string", "pattern": "^s-[0-9a-f]{24}$"},
    "scope_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "event_id": {"$ref": "#/$defs/event_id"},
        "session_ref": {"$ref": "#/$defs/session_ref"},
        "line": {"$ref": "#/$defs/line"}
      }
    },
    "scope_answer": {
      "$comment": "One scope's answer at the current reference point (step 0 S-10): a scope is a (layer, host, key) the host distinguishes, answered by its own newest eligible outcome.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "layer", "host", "scope", "status", "as_of", "session", "session_ref", "line",
                   "event_ids", "reasons", "evidence", "limitations", "freshness"],
      "properties": {
        "scope_id": {"$ref": "#/$defs/scope_id"},
        "layer": {"type": "string", "enum": ["native_global", "native_project", "native_memory", "native_undivided"]},
        "host": {"$ref": "#/$defs/host"},
        "scope": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["answered", "empty", "incomplete", "uncertain", "unknown"]},
        "as_of": {"type": ["string", "null"]},
        "session": {"type": ["string", "null"]},
        "session_ref": {"type": ["string", "null"], "pattern": "^p-[0-9a-f]{24}$"},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "event_ids": {"type": "array", "items": {"$ref": "#/$defs/event_id"}},
        "reasons": {"type": "array", "items": {"$ref": "#/$defs/scope_reason"}},
        "evidence": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["event_id", "as_of"],
          "properties": {"event_id": {"$ref": "#/$defs/event_id"}, "as_of": {"type": ["string", "null"]}}}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "freshness": {"type": "string", "minLength": 1}
      }
    },
    "scope_universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "no_scope", "cwd_unreadable", "memory_path_relative", "global_excluded_by_launch",
                   "ineligible"],
      "properties": {
        "host": {"$ref": "#/$defs/host"},
        "no_scope": {"type": "integer", "minimum": 0},
        "cwd_unreadable": {"type": "integer", "minimum": 0},
        "memory_path_relative": {"type": "integer", "minimum": 0},
        "global_excluded_by_launch": {"type": "integer", "minimum": 0},
        "ineligible": {"type": "integer", "minimum": 0}
      }
    },
    "owner_ref": {"type": "string", "pattern": "^o-[0-9a-f]{24}$"},
    "session_ref": {"type": "string", "pattern": "^p-[0-9a-f]{24}$"},
    "host": {"type": "string", "enum": ["claude", "codex"]},
    "line": {"type": "integer", "minimum": 1},
    "unknown_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "line": {"$ref": "#/$defs/line"}
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervals", "unknown"],
      "properties": {
        "intervals": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["owner_ref", "from", "to"],
          "properties": {"owner_ref": {"$ref": "#/$defs/owner_ref"}, "from": {"$ref": "#/$defs/line"},
                         "to": {"$ref": "#/$defs/line"}}}},
        "unknown": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["from", "to"],
          "properties": {"from": {"$ref": "#/$defs/line"}, "to": {"$ref": "#/$defs/line"}}}}
      }
    },
    "limitation": {
      "$comment": "One row per limitation kind; the code's LIMITATION_TABLE holds each kind to its own fields.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "enum": ["alt_paths", "undecodable", "member_rejected", "damaged", "agent_id_unusable",
                                            "member_duplicate"]},
        "count": {"type": "integer", "minimum": 1},
        "category": {"type": "string", "enum": ["not_json", "not_object", "member_not_object", "member_type_unmapped",
                                                "member_path_invalid", "member_content_invalid", "container_unusable",
                                                "locator_unusable", "locator_element_rejected"]},
        "line": {"$ref": "#/$defs/line"},
        "ordinal": {"type": "integer", "minimum": 0}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_ref", "session", "host", "kind", "transcript", "parent_ref", "binding", "read",
                   "lines_read", "owners", "ownership", "inherited_session_meta", "own_meta_unidentified",
                   "limitations", "event_refs", "segment_refs", "unknown", "pin", "delivery", "selection"],
      "properties": {
        "session_ref": {"$ref": "#/$defs/session_ref"},
        "session": {"type": "string"},
        "host": {"$ref": "#/$defs/host"},
        "kind": {"type": "string", "enum": ["main", "subagent"]},
        "transcript": {"type": "object", "additionalProperties": false, "required": ["host", "id", "source"],
                       "properties": {"host": {"$ref": "#/$defs/host"}, "id": {"type": "string"},
                                      "source": {"type": ["string", "null"]}}},
        "parent_ref": {"type": ["string", "null"], "pattern": "^p-[0-9a-f]{24}$"},
        "binding": {"type": "string", "enum": ["whole", "prefix", "none"]},
        "read": {"type": "string", "enum": ["bound", "appended", "changed", "unbound", "binding_invalid", "no_path",
                                            "unreadable"]},
        "lines_read": {"type": ["integer", "null"], "minimum": 0},
        "owners": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["owner_ref", "display"],
          "properties": {"owner_ref": {"$ref": "#/$defs/owner_ref"}, "display": {"type": "string"}}}},
        "ownership": {"$ref": "#/$defs/ownership"},
        "inherited_session_meta": {
          "type": "object", "additionalProperties": false, "required": ["another_session_id", "no_session_id"],
          "properties": {"another_session_id": {"type": "integer", "minimum": 0},
                         "no_session_id": {"type": "integer", "minimum": 0}}},
        "own_meta_unidentified": {"type": ["integer", "null"], "minimum": 1},
        "limitations": {"type": "array", "items": {"$ref": "#/$defs/limitation"}},
        "event_refs": {"type": "array", "items": {"$ref": "#/$defs/event_id"}},
        "segment_refs": {"type": "array", "items": {"$ref": "#/$defs/segment_id"}},
        "unknown": {"type": "array", "items": {"$ref": "#/$defs/unknown_entry"}},
        "pin": {"$ref": "#/$defs/pin"},
        "delivery": {"$ref": "#/$defs/delivery"},
        "selection": {"$ref": "#/$defs/session_selection"}
      }
    },
    "session_selection": {
      "$comment": "A session's selection (step 0 S-14, S-15): the shared selection inventory its own verified snapshot is (inventory_ref), or the one reason of the first broken link of its pin and snapshot.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "inventory_ref"],
      "properties": {
        "status": {"type": "string", "enum": ["read", "unpinned", "unknown"]},
        "reason": {"enum": ["unpinned", "id_space", "pin_absent", "pin_mismatch", "pin_content_ref_mismatch",
                            "input_failed", "input_unread", "snapshot_absent", null]},
        "inventory_ref": {"type": ["string", "null"], "pattern": "^i-[0-9a-f]{24}$"}
      }
    },
    "pin": {
      "$comment": "A session's own pin (step 0 S-14, S-15, S-16). reason is null exactly when the pin was read; content_ref is the one the pin names when the pin was read, agreeing with the census or not (pin_content_ref_mismatch), else the one the census row names (a Codex row's is read for nothing); baseline_ref is what the pin's verified snapshot names.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "content_ref", "baseline_ref", "include_global_instructions"],
      "properties": {
        "status": {"type": "string", "enum": ["read", "unpinned", "unknown"]},
        "reason": {"enum": ["unpinned", "id_space", "pin_absent", "pin_mismatch", "pin_content_ref_mismatch",
                            "input_failed", "input_unread", null]},
        "content_ref": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "baseline_ref": {"type": ["string", "null"]},
        "include_global_instructions": {"type": ["boolean", "null"]}
      }
    },
    "delivery": {
      "$comment": "Whether the session's own selected body was delivered (step 0 S-13, S-14): confirmed by a usable recorded occurrence its own owner holds, else unknown with ONE reason, the first broken link of the pin, its snapshot, the transcript read, a damaged injection event of its own owner and a recorded occurrence whose offsets could not be recovered (recorded_unmapped), and no_record only when none is broken.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "event_refs"],
      "properties": {
        "status": {"type": "string", "enum": ["confirmed", "unknown"]},
        "reason": {"enum": ["unpinned", "id_space", "pin_absent", "pin_mismatch", "pin_content_ref_mismatch",
                            "input_failed", "input_unread", "snapshot_absent", "unbound", "binding_invalid",
                            "no_path", "changed", "unreadable", "container_unusable", "locator_element_rejected",
                            "recorded_unmapped", "no_record", null]},
        "event_refs": {"type": "array", "items": {"$ref": "#/$defs/event_id"}}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "kind", "host", "session_ref", "owner_ref", "owner", "line", "at", "at_reason",
                   "damaged", "interval_from", "interval_to", "certain_to", "uncertain_reason", "where",
                   "rejected", "members"],
      "properties": {
        "event_id": {"$ref": "#/$defs/event_id"},
        "kind": {"type": "string", "enum": ["native", "session_injection"]},
        "host": {"$ref": "#/$defs/host"},
        "session_ref": {"$ref": "#/$defs/session_ref"},
        "owner_ref": {"type": ["string", "null"], "pattern": "^o-[0-9a-f]{24}$"},
        "owner": {"type": "string"},
        "line": {"$ref": "#/$defs/line"},
        "at": {"type": ["string", "null"]},
        "at_reason": {"enum": ["undated", "undated_naive", null]},
        "damaged": {"enum": ["container_unusable", "locator_element_rejected", null]},
        "interval_from": {"type": ["integer", "null"], "minimum": 1},
        "interval_to": {"type": ["integer", "null"], "minimum": 1},
        "certain_to": {"type": ["integer", "null"], "minimum": 1},
        "uncertain_reason": {"enum": ["undecodable_after", "ownership_unknown", null]},
        "where": {"type": ["string", "null"]},
        "rejected": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["ordinal", "category"],
          "properties": {"ordinal": {"type": "integer", "minimum": 0},
                         "category": {"enum": ["member_not_object", "member_type_unmapped", "member_path_invalid",
                                               "member_content_invalid"]}}}},
        "members": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["ordinal", "carrier_id", "version_sha256"],
          "properties": {"ordinal": {"type": "integer", "minimum": 0},
                         "carrier_id": {"type": "string", "pattern": "^c-[0-9a-f]{24}$"},
                         "version_sha256": {"$ref": "#/$defs/sha256"}}}}
      }
    },
    "layer_name": {
      "type": "string",
      "enum": [
        "catalog",
        "adopted_packages",
        "overlays",
        "native_global",
        "native_project",
        "native_settings",
        "native_memory",
        "native_undivided",
        "session_injection",
        "ledger_incubating",
        "ledger_keep"
      ]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "unit_ref",
        "layer",
        "path",
        "heading",
        "n",
        "text",
        "sha",
        "class",
        "operative_context",
        "version_sha256",
        "redaction_version"
      ],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^u-[0-9a-f]{16}(-[0-9]+)?$"},
        "unit_ref": {"$ref": "#/$defs/unit_ref"},
        "layer": {"$ref": "#/$defs/layer_name"},
        "path": {"type": "string", "minLength": 1},
        "heading": {"type": "string"},
        "n": {"type": "integer", "minimum": 1},
        "text": {"type": "string"},
        "sha": {"$ref": "#/$defs/sha256"},
        "class": {"type": "string", "enum": ["operative", "reference"]},
        "operative_context": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "version_sha256": {"$ref": "#/$defs/sha256"},
        "redaction_version": {"type": "string", "pattern": "^r[0-9]+$"},
        "block": {"type": "string", "minLength": 1},
        "item_ref": {"type": ["string", "null"]},
        "package_id": {"type": ["string", "null"]},
        "carrier_id": {
          "$comment": "opaque: an identity, not a spelling of what it was built from",
          "type": "string",
          "pattern": "^c-[0-9a-f]{24}$"
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as_of": {"type": ["string", "null"]},
        "session": {"type": ["string", "null"]},
        "transcript": {"type": ["string", "null"]},
        "where": {"type": ["string", "null"]},
        "scope": {"type": ["string", "null"]},
        "reference": {"type": ["string", "null"]},
        "record": {"type": ["integer", "null"]},
        "identity": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "keep_units": {"type": "array", "items": {"type": "string"}},
        "keep_reason": {"type": ["string", "null"]},
        "hosts": {"type": "array", "items": {"type": "string"}},
        "scope_id": {"$ref": "#/$defs/scope_id"},
        "event_id": {"$ref": "#/$defs/event_id"},
        "git": {"$ref": "#/$defs/git"}
      }
    },
    "layer_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "producer", "status", "reasons", "units", "empty"],
      "properties": {
        "layer": {"$ref": "#/$defs/layer_name"},
        "producer": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["complete", "incomplete", "unsupported", "unknown"]},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "units": {"type": "integer", "minimum": 0},
        "empty": {"type": "boolean"}
      }
    }
  }
}
