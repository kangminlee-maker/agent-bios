{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "design §7.3",
  "title": "Expected observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["occasion_criteria", "exposure_rule", "expected_behavior", "retrieval_terms", "expiry"],
  "dependentRequired": {"counter": ["threshold"], "threshold": ["counter"]},
  "properties": {
    "occasion_criteria": {"type": "string", "minLength": 1},
    "exposure_rule": {"type": "string", "minLength": 1},
    "expected_behavior": {"type": "string", "minLength": 1},
    "retrieval_terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expiry": {"type": "string", "minLength": 1},
    "counter": {"type": "string", "minLength": 1},
    "threshold": {"type": "number"}
  }
}
